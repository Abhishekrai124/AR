    },
    "var_5aa2eb51ee38": {
      "type": "variant",
      "label": "01 · Checkout First",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css');\n</style>\n<main class=\"min-h-screen overflow-hidden bg-[#0f172a] font-[Manrope] text-[#fff7fb]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"pointer-events-none fixed inset-0 opacity-35\" data-kid=\"1-1\" data-name=\"background decorative gradient layer\" style=\"background-image:radial-gradient(circle at 10% 7%, rgba(56,189,248,.17), transparent 24rem),radial-gradient(circle at 88% 22%, rgba(249,168,212,.14), transparent 27rem),linear-gradient(rgba(125,211,252,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(125,211,252,.045) 1px,transparent 1px);background-size:auto,auto,36px 36px,36px 36px\">\n    </div>\n    <div class=\"relative mx-auto w-[min(1240px,calc(100%-48px))]\" data-kid=\"1-2\" data-name=\"page content wrapper\">\n        <header class=\"flex h-[84px] items-center justify-between border-b border-[#7dd3fc]/20\" data-kid=\"1-2-1\" data-name=\"header navigation section\">\n            <a class=\"text-[22px] font-extrabold tracking-[-1px] text-[#fff7fb] no-underline\" data-kid=\"1-2-1-1\" data-name=\"site logo link\" href=\"#\">\n                ar\n                <span class=\"font-[Playfair_Display] font-semibold italic\" data-kid=\"1-2-1-1-1\" data-name=\"logo text part\">\n                    rai\n                </span>\n                .in\n                <b class=\"align-top text-[11px] text-[#f9a8d4]\" data-kid=\"1-2-1-1-2\" data-name=\"logo star icon\">\n                    ✦\n                </b>\n            </a>\n            <nav aria-label=\"Authenticated site navigation\" class=\"flex items-center gap-1 rounded-full border border-[#7dd3fc]/15 bg-[#081426]/65 p-1.5 text-[12px] font-bold text-[#c4cbe0] shadow-lg shadow-[#020617]/20 backdrop-blur\" data-kid=\"1-2-1-2\" data-name=\"authenticated site navigation menu\">\n                <a class=\"rounded-full px-3 py-2 hover:text-[#38bdf8]\" data-kid=\"1-2-1-2-1\" data-name=\"navigation home link\" href=\"#\">\n                    Home\n                </a>\n                <a class=\"rounded-full px-3 py-2 hover:text-[#38bdf8]\" data-kid=\"1-2-1-2-2\" data-name=\"navigation community link\" href=\"#\">\n                    Community\n                </a>\n                <a class=\"rounded-full px-3 py-2 hover:text-[#38bdf8]\" data-kid=\"1-2-1-2-3\" data-name=\"navigation projects link\" href=\"#\">\n                    Projects\n                </a>\n                <a class=\"rounded-full bg-[#38bdf8]/10 px-3 py-2 text-[#7dd3fc]\" data-kid=\"1-2-1-2-4\" data-name=\"navigation arrai pay link\" href=\"#\">\n                    ARRAI Pay\n                </a>\n                <span class=\"mx-1 h-5 w-px bg-[#7dd3fc]/20\" data-kid=\"1-2-1-2-5\" data-name=\"navigation menu separator\">\n                </span>\n                <a class=\"flex items-center gap-2 rounded-full px-2.5 py-1.5 text-[#fff7fb]\" data-kid=\"1-2-1-2-6\" data-name=\"user account link\" href=\"#\">\n                    <span class=\"grid size-7 place-items-center rounded-full bg-gradient-to-br from-[#7dd3fc] to-[#a5b4fc] text-[10px] text-[#0f172a]\" data-kid=\"1-2-1-2-6-1\" data-name=\"user initials badge\">\n                        AR\n                    </span>\n                    <span data-kid=\"1-2-1-2-6-2\" data-name=\"user profile name\">\n                        Abhishek\n                    </span>\n                </a>\n                <a class=\"rounded-full border border-[#f9a8d4]/35 bg-[#831843]/20 px-3 py-2 text-[10px] text-[#fce7f3]\" data-kid=\"1-2-1-2-7\" data-name=\"wallet coming soon link\" href=\"#wallet\">\n                    <i aria-hidden=\"true\" class=\"ti ti-wallet mr-1.5 text-[13px]\" data-kid=\"1-2-1-2-7-1\" data-name=\"wallet icon\">\n                    </i>\n                    Wallet coming soon\n                </a>\n            </nav>\n        </header>\n        <section aria-labelledby=\"pay-title\" class=\"grid grid-cols-[1.15fr_.85fr] gap-12 py-16 max-lg:grid-cols-1\" data-kid=\"1-2-2\" data-name=\"hero payment overview section\">\n            <div class=\"max-w-[720px]\" data-kid=\"1-2-2-1\" data-name=\"hero text content block\">\n                <p class=\"mb-5 flex items-center gap-2 font-[DM_Mono] text-[11px] uppercase tracking-[.14em] text-[#7dd3fc]\" data-kid=\"1-2-2-1-1\" data-name=\"signed-in status label\">\n                    <span class=\"size-2 rounded-full bg-[#bef264] shadow-[0_0_14px_#bef264]\" data-kid=\"1-2-2-1-1-1\" data-name=\"signed-in indicator dot\">\n                    </span>\n                    Signed in securely · ARRAI Pay\n                </p>\n                <h1 class=\"text-[clamp(48px,6.3vw,82px)] font-extrabold leading-[.94] tracking-[-.075em]\" data-kid=\"1-2-2-1-2\" data-name=\"hero headline\" id=\"pay-title\">\n                    Pay for ARRAI,\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"headline line break\"/>\n                    <em class=\"font-[Playfair_Display] font-semibold text-[#f9a8d4]\" data-kid=\"1-2-2-1-2-2\" data-name=\"headline emphasized text\">\n                        clearly and securely.\n                    </em>\n                </h1>\n                <p class=\"mt-7 max-w-[580px] text-[16px] leading-8 text-[#c4cbe0]\" data-kid=\"1-2-2-1-3\" data-name=\"hero description text\">\n                    Use Razorpay checkout for supported ARRAI payments today. Your payment is confirmed only after server verification.\n                </p>\n                <div class=\"mt-8 flex flex-wrap gap-3 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-2-1-4\" data-name=\"payment security badges container\">\n                    <span class=\"rounded-full border border-[#7dd3fc]/20 bg-[#162238]/70 px-3 py-2\" data-kid=\"1-2-2-1-4-1\" data-name=\"razorpay checkout security badge\">\n                        <i aria-hidden=\"true\" class=\"ti ti-shield-check mr-1 text-[#7dd3fc]\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"razorpay shield icon\">\n                        </i>\n                        Razorpay checkout\n                    </span>\n                    <span class=\"rounded-full border border-[#7dd3fc]/20 bg-[#162238]/70 px-3 py-2\" data-kid=\"1-2-2-1-4-2\" data-name=\"server verification security badge\">\n                        <i aria-hidden=\"true\" class=\"ti ti-lock mr-1 text-[#a5b4fc]\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"server lock icon\">\n                        </i>\n                        Server-side verification\n                    </span>\n                    <span class=\"rounded-full border border-[#7dd3fc]/20 bg-[#162238]/70 px-3 py-2\" data-kid=\"1-2-2-1-4-3\" data-name=\"signed-in security badge\">\n                        <i aria-hidden=\"true\" class=\"ti ti-user-check mr-1 text-[#f9a8d4]\" data-kid=\"1-2-2-1-4-3-1\" data-name=\"user check icon\">\n                        </i>\n                        Signed-in account\n                    </span>\n                </div>\n            </div>\n            <aside aria-label=\"Payment boundary\" class=\"self-end rounded-[22px] border border-[#f9a8d4]/35 bg-gradient-to-br from-[#312e81]/60 to-[#831843]/35 p-6 shadow-2xl shadow-[#020617]/35\" data-kid=\"1-2-2-2\" data-name=\"payment boundary aside\">\n                <div class=\"flex items-start gap-4\" data-kid=\"1-2-2-2-1\" data-name=\"warning notice container\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-2xl bg-[#f9a8d4] text-[21px] text-[#172033]\" data-kid=\"1-2-2-2-1-1\" data-name=\"warning icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"info circle icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-2-2-1-2\" data-name=\"warning text block\">\n                        <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.14em] text-[#f9a8d4]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"warning pre-title\">\n                            Before you pay\n                        </p>\n                        <h2 class=\"mt-2 text-[22px] font-extrabold tracking-[-.04em]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"warning headline\">\n                            Payment today does not add money to an ARRAI Wallet.\n                        </h2>\n                        <p class=\"mt-3 text-[12px] leading-6 text-[#d9d5ed]\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"warning description text\">\n                            ARRAI Wallet has not launched. A successful payment is not wallet credit and does not create a stored balance.\n                        </p>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <section aria-label=\"Checkout status\" class=\"border-y border-[#7dd3fc]/20 py-4\" data-kid=\"1-2-3\" data-name=\"checkout status banner section\">\n            <div class=\"flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-3-1\" data-name=\"checkout status content container\">\n                <p class=\"flex items-center gap-2 text-[12px] font-semibold text-[#d9f99d]\" data-kid=\"1-2-3-1-1\" data-name=\"status confirmation message\">\n                    <i aria-hidden=\"true\" class=\"ti ti-circle-check-filled text-[16px]\" data-kid=\"1-2-3-1-1-1\" data-name=\"check icon\">\n                    </i>\n                    Razorpay checkout is available for supported ARRAI payments.\n                </p>\n                <p class=\"text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-3-1-2\" data-name=\"contact support link container\">\n                    Need help?\n                    <a class=\"font-bold text-[#7dd3fc] underline underline-offset-4\" data-kid=\"1-2-3-1-2-1\" data-name=\"contact support link\" href=\"#\">\n                        Contact ARRAI before paying\n                    </a>\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"checkout-title\" class=\"py-14\" data-kid=\"1-2-4\" data-name=\"checkout actions section\">\n            <div class=\"mb-7 flex items-end justify-between gap-4\" data-kid=\"1-2-4-1\" data-name=\"checkout header container\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"checkout header text block\">\n                    <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.14em] text-[#7dd3fc]\" data-kid=\"1-2-4-1-1-1\" data-name=\"available now label\">\n                        Available now\n                    </p>\n                    <h2 class=\"mt-2 text-[36px] font-extrabold tracking-[-.06em]\" data-kid=\"1-2-4-1-1-2\" data-name=\"checkout headline\" id=\"checkout-title\">\n                        Open checkout\n                    </h2>\n                </div>\n                <p class=\"max-w-[360px] text-right text-[11px] leading-5 text-[#c4cbe0]\" data-kid=\"1-2-4-1-2\" data-name=\"checkout instruction description\">\n                    Only these actions open a payment flow. Confirmation appears here after Razorpay and server verification.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-[1.15fr_.85fr] gap-5 max-lg:grid-cols-1\" data-kid=\"1-2-4-2\" data-name=\"checkout cards grid\">\n                <article class=\"rounded-[22px] border border-[#38bdf8]/45 bg-[#162238]/85 p-7 shadow-[0_22px_60px_rgba(2,6,23,.25)]\" data-kid=\"1-2-4-2-1\" data-name=\"custom payment card\">\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-4-2-1-1\" data-name=\"custom payment card header\">\n                        <div data-kid=\"1-2-4-2-1-1-1\" data-name=\"payment card icon container\">\n                            <span class=\"grid size-11 place-items-center rounded-2xl bg-[#38bdf8]/15 text-[22px] text-[#7dd3fc]\" data-kid=\"1-2-4-2-1-1-1-1\" data-name=\"credit card icon\">\n                                <i aria-hidden=\"true\" class=\"ti ti-credit-card-pay\" data-kid=\"1-2-4-2-1-1-1-1-1\">\n                                </i>\n                            </span>\n                            <p class=\"mt-5 font-[DM_Mono] text-[10px] uppercase tracking-[.14em] text-[#7dd3fc]\" data-kid=\"1-2-4-2-1-1-1-2\">\n                                Custom payment\n                            </p>\n                            <h3 class=\"mt-2 text-[28px] font-extrabold tracking-[-.05em]\" data-kid=\"1-2-4-2-1-1-1-3\">\n                                Pay an amount\n                            </h3>\n                            <p class=\"mt-3 max-w-[480px] text-[13px] leading-6 text-[#c4cbe0]\" data-kid=\"1-2-4-2-1-1-1-4\">\n                                Choose an amount for an approved ARRAI payment, then continue to Razorpay.\n                            </p>\n                        </div>\n                        <span class=\"rounded-full border border-[#bef264]/35 bg-[#bef264]/10 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#d9f99d]\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"custom payment label\">\n                            Live\n                        </span>\n                    </div>\n                    <div class=\"mt-7 border-y border-[#7dd3fc]/15 py-5\" data-kid=\"1-2-4-2-1-2\" data-name=\"amount selection area\">\n                        <p class=\"mb-3 text-[11px] font-bold text-[#c4cbe0]\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"amount selection label\">\n                            Choose amount (INR)\n                        </p>\n                        <div class=\"flex flex-wrap gap-2\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"amount buttons container\">\n                            <button class=\"rounded-xl border border-[#38bdf8] bg-[#38bdf8] px-4 py-2.5 text-[13px] font-extrabold text-[#0f172a]\" data-kid=\"1-2-4-2-1-2-2-1\" data-name=\"amount button 49\" type=\"button\">\n                                ₹49\n                            </button>\n                            <button class=\"rounded-xl border border-[#7dd3fc]/30 bg-[#0f1d31] px-4 py-2.5 text-[13px] font-bold text-[#fff7fb]\" data-kid=\"1-2-4-2-1-2-2-2\" data-name=\"amount button 99\" type=\"button\">\n                                ₹99\n                            </button>\n                            <button class=\"rounded-xl border border-[#7dd3fc]/30 bg-[#0f1d31] px-4 py-2.5 text-[13px] font-bold text-[#fff7fb]\" data-kid=\"1-2-4-2-1-2-2-3\" data-name=\"amount button 299\" type=\"button\">\n                                ₹299\n                            </button>\n                            <span class=\"flex items-center rounded-xl border border-dashed border-[#7dd3fc]/30 px-4 text-[12px] text-[#c4cbe0]\" data-kid=\"1-2-4-2-1-2-2-4\" data-name=\"other amount prompt\">\n                                Other amount at checkout\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-6 flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-4-2-1-3\" data-name=\"checkout call to action area\">\n                        <p class=\"text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-4-2-1-3-1\" data-name=\"selected amount status\">\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right mr-1 text-[#7dd3fc]\" data-kid=\"1-2-4-2-1-3-1-1\" data-name=\"arrow icon\">\n                            </i>\n                            Selected:\n                            <strong class=\"text-[#fff7fb]\" data-kid=\"1-2-4-2-1-3-1-2\" data-name=\"selected amount value\">\n                                ₹49\n                            </strong>\n                            · Opens Razorpay checkout\n                        </p>\n                        <button class=\"inline-flex items-center gap-7 rounded-xl bg-gradient-to-r from-[#0284c7] to-[#4f46e5] px-5 py-3.5 text-[12px] font-extrabold text-white shadow-lg shadow-[#2563eb]/20\" data-kid=\"1-2-4-2-1-3-2\" data-name=\"razorpay checkout button\" type=\"button\">\n                            Open Razorpay checkout\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-2-4-2-1-3-2-1\" data-name=\"checkout arrow icon\">\n                            </i>\n                        </button>\n                    </div>\n                </article>\n                <article class=\"rounded-[22px] border border-[#f9a8d4]/35 bg-gradient-to-br from-[#4f46e5]/40 to-[#831843]/45 p-7 shadow-[0_22px_60px_rgba(2,6,23,.25)]\" data-kid=\"1-2-4-2-2\" data-name=\"gold membership card\">\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-4-2-2-1\" data-name=\"gold card header\">\n                        <span class=\"grid size-11 place-items-center rounded-2xl bg-[#fde68a] text-[22px] text-[#4c1d3d]\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"gold card icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-crown\" data-kid=\"1-2-4-2-2-1-1-1\" data-name=\"crown icon\">\n                            </i>\n                        </span>\n                        <span class=\"rounded-full border border-[#fde68a]/45 bg-[#fde68a]/15 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#fef3c7]\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"gold card live status badge\">\n                            Live\n                        </span>\n                    </div>\n                    <p class=\"mt-5 font-[DM_Mono] text-[10px] uppercase tracking-[.14em] text-[#f9a8d4]\" data-kid=\"1-2-4-2-2-2\" data-name=\"gold card label\">\n                        Gold membership\n                    </p>\n                    <h3 class=\"mt-2 text-[28px] font-extrabold tracking-[-.05em]\" data-kid=\"1-2-4-2-2-3\" data-name=\"gold card headline\">\n                        Pay ₹45 for Gold VIP\n                    </h3>\n                    <p class=\"mt-3 text-[13px] leading-6 text-[#e9d5ff]\" data-kid=\"1-2-4-2-2-4\" data-name=\"gold card description\">\n                        Unlocks Gold membership only after ARRAI verifies the completed Razorpay payment.\n                    </p>\n                    <ul class=\"mt-6 grid gap-2 border-y border-white/15 py-5 text-[11px] leading-5 text-[#fce7f3]\" data-kid=\"1-2-4-2-2-5\" data-name=\"gold card benefits list\">\n                        <li data-kid=\"1-2-4-2-2-5-1\" data-name=\"gold benefit item 1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-check mr-2 text-[#fde68a]\" data-kid=\"1-2-4-2-2-5-1-1\" data-name=\"gold benefit check icon 1\">\n                            </i>\n                            Gold verification tick\n                        </li>\n                        <li data-kid=\"1-2-4-2-2-5-2\" data-name=\"gold benefit item 2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-check mr-2 text-[#fde68a]\" data-kid=\"1-2-4-2-2-5-2-1\" data-name=\"gold benefit check icon 2\">\n                            </i>\n                            VIP profile themes\n                        </li>\n                        <li data-kid=\"1-2-4-2-2-5-3\" data-name=\"gold benefit item 3\">\n                            <i aria-hidden=\"true\" class=\"ti ti-check mr-2 text-[#fde68a]\" data-kid=\"1-2-4-2-2-5-3-1\" data-name=\"gold benefit check icon 3\">\n                            </i>\n                            VIP badge in community\n                        </li>\n                    </ul>\n                    <button class=\"mt-6 inline-flex w-full items-center justify-between rounded-xl bg-[#fde68a] px-5 py-3.5 text-[12px] font-extrabold text-[#4c1d3d]\" data-kid=\"1-2-4-2-2-6\" data-name=\"gold card checkout button\" type=\"button\">\n                        Open Razorpay checkout\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-2-4-2-2-6-1\" data-name=\"gold checkout arrow icon\">\n                        </i>\n                    </button>\n                    <p class=\"mt-3 text-[10px] leading-5 text-[#fce7f3]/70\" data-kid=\"1-2-4-2-2-7\" data-name=\"gold card disclaimer\">\n                        Payment can be pending until verification completes.\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"wallet-title\" class=\"grid grid-cols-[.82fr_1.18fr] overflow-hidden rounded-[24px] border border-[#a5b4fc]/30 bg-[#162238]/75 max-lg:grid-cols-1\" data-kid=\"1-2-5\" data-name=\"arrai wallet info section\" id=\"wallet\">\n            <div class=\"border-r border-[#a5b4fc]/25 bg-gradient-to-br from-[#312e81]/35 to-[#162238]/20 p-8 max-lg:border-r-0 max-lg:border-b\" data-kid=\"1-2-5-1\" data-name=\"wallet features sidebar\">\n                <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.14em] text-[#c4b5fd]\" data-kid=\"1-2-5-1-1\" data-name=\"wallet account scope label\">\n                    Account scope\n                </p>\n                <div class=\"mt-5 flex items-center gap-4\" data-kid=\"1-2-5-1-2\" data-name=\"wallet title area\">\n                    <span class=\"grid size-12 place-items-center rounded-2xl bg-[#a5b4fc]/15 text-[25px] text-[#c4b5fd]\" data-kid=\"1-2-5-1-2-1\" data-name=\"wallet icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-wallet\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"wallet icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-5-1-2-2\" data-name=\"wallet title block\">\n                        <h2 class=\"text-[30px] font-extrabold tracking-[-.055em]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"wallet section headline\" id=\"wallet-title\">\n                            ARRAI Wallet\n                        </h2>\n                        <p class=\"text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"wallet section sub-label\">\n                            For signed-in accounts\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-8 rounded-2xl border border-[#a5b4fc]/25 bg-[#0f172a]/60 p-5\" data-kid=\"1-2-5-1-3\" data-name=\"wallet balance display card\">\n                    <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.13em] text-[#c4cbe0]\" data-kid=\"1-2-5-1-3-1\" data-name=\"wallet balance label\">\n                        Wallet balance\n                    </p>\n                    <p class=\"mt-2 text-[27px] font-extrabold tracking-[-.05em] text-[#fff7fb]\" data-kid=\"1-2-5-1-3-2\" data-name=\"wallet balance value\">\n                        Not available\n                    </p>\n                    <p class=\"mt-3 text-[11px] leading-5 text-[#c4cbe0]\" data-kid=\"1-2-5-1-3-3\" data-name=\"wallet balance description\">\n                        ARRAI does not yet have a wallet account or stored-value ledger.\n                    </p>\n                </div>\n            </div>\n            <div class=\"p-8\" data-kid=\"1-2-5-2\" data-name=\"wallet inactive status area\">\n                <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.14em] text-[#f9a8d4]\" data-kid=\"1-2-5-2-1\" data-name=\"wallet inactive label\">\n                    Not active yet\n                </p>\n                <h3 class=\"mt-2 text-[28px] font-extrabold tracking-[-.05em]\" data-kid=\"1-2-5-2-2\" data-name=\"wallet inactive headline\">\n                    ARRAI Wallet is not available yet.\n                </h3>\n                <p class=\"mt-3 max-w-[650px] text-[13px] leading-6 text-[#c4cbe0]\" data-kid=\"1-2-5-2-3\" data-name=\"wallet inactive description\">\n                    When available, wallet features will be introduced with the proper account, security and payment infrastructure. Until then, payments go through Razorpay—not a wallet.\n                </p>\n                <div class=\"mt-7 border-t border-[#7dd3fc]/15 pt-5\" data-kid=\"1-2-5-2-4\" data-name=\"wallet ledger info area\">\n                    <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-5-2-4-1\" data-name=\"wallet history container\">\n                        <div data-kid=\"1-2-5-2-4-1-1\" data-name=\"wallet history header\">\n                            <h4 class=\"text-[14px] font-bold\" data-kid=\"1-2-5-2-4-1-1-1\" data-name=\"wallet history title\">\n                                Wallet history\n                            </h4>\n                            <p class=\"mt-1 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-5-2-4-1-1-2\" data-name=\"wallet history sub-label\">\n                                A wallet ledger is not available yet.\n                            </p>\n                        </div>\n                        <span class=\"rounded-full border border-[#7dd3fc]/20 px-3 py-1.5 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#c4cbe0]\" data-kid=\"1-2-5-2-4-1-2\" data-name=\"no history badge\">\n                            No history to show\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"roadmap-title\" class=\"py-14\" data-kid=\"1-2-6\" data-name=\"future roadmap section\">\n            <div class=\"mb-7\" data-kid=\"1-2-6-1\" data-name=\"roadmap header container\">\n                <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.14em] text-[#a5b4fc]\" data-kid=\"1-2-6-1-1\" data-name=\"roadmap label\">\n                    Future roadmap\n                </p>\n                <h2 class=\"mt-2 text-[36px] font-extrabold tracking-[-.06em]\" data-kid=\"1-2-6-1-2\" data-name=\"roadmap headline\" id=\"roadmap-title\">\n                    What ARRAI Pay may add later\n                </h2>\n                <p class=\"mt-3 max-w-[640px] text-[12px] leading-6 text-[#c4cbe0]\" data-kid=\"1-2-6-1-3\" data-name=\"roadmap description\">\n                    These are planned capabilities, not payment actions. They are unavailable today.\n                </p>\n            </div>\n            <div class=\"divide-y divide-[#7dd3fc]/15 rounded-[20px] border border-[#7dd3fc]/20 bg-[#162238]/55 px-6\" data-kid=\"1-2-6-2\" data-name=\"roadmap items list\">\n                <div class=\"grid grid-cols-[46px_1fr_auto] items-center gap-5 py-5 max-sm:grid-cols-[40px_1fr]\" data-kid=\"1-2-6-2-1\" data-name=\"roadmap item 1\">\n                    <span class=\"grid size-10 place-items-center rounded-xl bg-[#38bdf8]/10 text-[#7dd3fc]\" data-kid=\"1-2-6-2-1-1\" data-name=\"roadmap icon container 1\">\n                        <i aria-hidden=\"true\" class=\"ti ti-circle-plus text-[20px]\" data-kid=\"1-2-6-2-1-1-1\" data-name=\"add money icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-6-2-1-2\" data-name=\"roadmap item text 1\">\n                        <h3 class=\"text-[14px] font-bold\" data-kid=\"1-2-6-2-1-2-1\" data-name=\"roadmap item title 1\">\n                            Add money to wallet\n                        </h3>\n                        <p class=\"mt-1 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-6-2-1-2-2\" data-name=\"roadmap item description 1\">\n                            Store funds in an ARRAI Wallet for eligible site purchases.\n                        </p>\n                    </div>\n                    <span class=\"justify-self-end rounded-full border border-[#c4cbe0]/20 px-3 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#c4cbe0]\" data-kid=\"1-2-6-2-1-3\" data-name=\"planned status badge 1\">\n                        Planned\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[46px_1fr_auto] items-center gap-5 py-5 max-sm:grid-cols-[40px_1fr]\" data-kid=\"1-2-6-2-2\" data-name=\"roadmap item 2\">\n                    <span class=\"grid size-10 place-items-center rounded-xl bg-[#f9a8d4]/10 text-[#f9a8d4]\" data-kid=\"1-2-6-2-2-1\" data-name=\"roadmap icon container 2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-shopping-bag text-[20px]\" data-kid=\"1-2-6-2-2-1-1\" data-name=\"spend money icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-6-2-2-2\" data-name=\"roadmap item text 2\">\n                        <h3 class=\"text-[14px] font-bold\" data-kid=\"1-2-6-2-2-2-1\" data-name=\"roadmap item title 2\">\n                            Spend with wallet\n                        </h3>\n                        <p class=\"mt-1 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-6-2-2-2-2\" data-name=\"roadmap item description 2\">\n                            Use wallet funds for eligible ARRAI services and community purchases.\n                        </p>\n                    </div>\n                    <span class=\"justify-self-end rounded-full border border-[#c4cbe0]/20 px-3 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#c4cbe0]\" data-kid=\"1-2-6-2-2-3\" data-name=\"planned status badge 2\">\n                        Planned\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[46px_1fr_auto] items-center gap-5 py-5 max-sm:grid-cols-[40px_1fr]\" data-kid=\"1-2-6-2-3\" data-name=\"roadmap item 3\">\n                    <span class=\"grid size-10 place-items-center rounded-xl bg-[#a5b4fc]/10 text-[#c4b5fd]\" data-kid=\"1-2-6-2-3-1\" data-name=\"roadmap icon container 3\">\n                        <i aria-hidden=\"true\" class=\"ti ti-scan text-[20px]\" data-kid=\"1-2-6-2-3-1-1\" data-name=\"scan pay icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-6-2-3-2\" data-name=\"roadmap item text 3\">\n                        <h3 class=\"text-[14px] font-bold\" data-kid=\"1-2-6-2-3-2-1\" data-name=\"roadmap item title 3\">\n                            Scan & pay by UPI\n                        </h3>\n                        <p class=\"mt-1 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-6-2-3-2-2\" data-name=\"roadmap item description 3\">\n                            A future UPI scan-and-pay experience, subject to supported payment infrastructure.\n                        </p>\n                    </div>\n                    <span class=\"justify-self-end rounded-full border border-[#c4cbe0]/20 px-3 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#c4cbe0]\" data-kid=\"1-2-6-2-3-3\" data-name=\"planned status badge 3\">\n                        Planned\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[46px_1fr_auto] items-center gap-5 py-5 max-sm:grid-cols-[40px_1fr]\" data-kid=\"1-2-6-2-4\" data-name=\"roadmap item 4\">\n                    <span class=\"grid size-10 place-items-center rounded-xl bg-[#bef264]/10 text-[#d9f99d]\" data-kid=\"1-2-6-2-4-1\" data-name=\"roadmap icon container 4\">\n                        <i aria-hidden=\"true\" class=\"ti ti-building-bank text-[20px]\" data-kid=\"1-2-6-2-4-1-1\" data-name=\"bank transfer icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-6-2-4-2\" data-name=\"roadmap item text 4\">\n                        <h3 class=\"text-[14px] font-bold\" data-kid=\"1-2-6-2-4-2-1\" data-name=\"roadmap item title 4\">\n                            Send to bank account\n                        </h3>\n                        <p class=\"mt-1 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-6-2-4-2-2\" data-name=\"roadmap item description 4\">\n                            A future transfer capability requiring compliant payout infrastructure.\n                        </p>\n                    </div>\n                    <span class=\"justify-self-end rounded-full border border-[#c4cbe0]/20 px-3 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#c4cbe0]\" data-kid=\"1-2-6-2-4-3\" data-name=\"planned status badge 4\">\n                        Planned\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[46px_1fr_auto] items-center gap-5 py-5 max-sm:grid-cols-[40px_1fr]\" data-kid=\"1-2-6-2-5\" data-name=\"roadmap item 5\">\n                    <span class=\"grid size-10 place-items-center rounded-xl bg-[#fde68a]/10 text-[#fde68a]\" data-kid=\"1-2-6-2-5-1\" data-name=\"roadmap icon container 5\">\n                        <i aria-hidden=\"true\" class=\"ti ti-device-mobile text-[20px]\" data-kid=\"1-2-6-2-5-1-1\" data-name=\"mobile recharge icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-6-2-5-2\" data-name=\"roadmap item text 5\">\n                        <h3 class=\"text-[14px] font-bold\" data-kid=\"1-2-6-2-5-2-1\" data-name=\"roadmap item title 5\">\n                            Mobile recharge\n                        </h3>\n                        <p class=\"mt-1 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-6-2-5-2-2\" data-name=\"roadmap item description 5\">\n                            A future bill-payment feature. It cannot be requested or paid through ARRAI Pay today.\n                        </p>\n                    </div>\n                    <span class=\"justify-self-end rounded-full border border-[#c4cbe0]/20 px-3 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.12em] text-[#c4cbe0]\" data-kid=\"1-2-6-2-5-3\" data-name=\"planned status badge 5\">\n                        Planned\n                    </span>\n                </div>\n            </div>\n        </section>\n        <footer class=\"flex items-center justify-between border-t border-[#7dd3fc]/20 py-8 text-[11px] text-[#c4cbe0]\" data-kid=\"1-2-7\" data-name=\"page footer\">\n            <p data-kid=\"1-2-7-1\" data-name=\"footer copyright notice\">\n                © 2026 ARRAI · Payments are processed by Razorpay where available.\n            </p>\n            <div class=\"flex gap-5\" data-kid=\"1-2-7-2\" data-name=\"footer links container\">\n                <a class=\"text-[#c4cbe0]\" data-kid=\"1-2-7-2-1\" data-name=\"footer payment help link\" href=\"#\">\n                    Payment help\n                </a>\n                <a class=\"text-[#c4cbe0]\" data-kid=\"1-2-7-2-2\" data-name=\"footer privacy link\" href=\"#\">\n                    Privacy\n                </a>\n                <a class=\"text-[#c4cbe0]\" data-kid=\"1-2-7-2-3\" data-name=\"footer terms link\" href=\"#\">\n                    Terms\n                </a>\n            </div>\n        </footer>\n    </div>\n</main>\n",
