        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen overflow-hidden bg-[#0f172a] font-[Manrope] text-[#fff7fb] selection:bg-pink-300 selection:text-slate-900\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"pointer-events-none fixed inset-0 opacity-50\" data-kid=\"1-1\" data-name=\"background decoration gradient\" style=\"background-image:radial-gradient(circle at 12% 0%,rgba(56,189,248,.17),transparent 25%),radial-gradient(circle at 92% 9%,rgba(249,168,212,.14),transparent 25%),linear-gradient(rgba(125,211,252,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(125,211,252,.035) 1px,transparent 1px);background-size:auto,auto,44px 44px\">\n    </div>\n    <header class=\"relative z-10 mx-auto flex h-[84px] w-[calc(100%-48px)] max-w-[1250px] items-center justify-between border-b border-sky-200/20\" data-kid=\"1-2\" data-name=\"site header\">\n        <a class=\"flex items-baseline gap-1 text-[22px] font-extrabold tracking-[-1px] text-[#fff7fb] no-underline\" data-kid=\"1-2-1\" data-name=\"site brand identity\" href=\"#\">\n            ar\n            <span class=\"font-[Playfair_Display] font-semibold italic\" data-kid=\"1-2-1-1\" data-name=\"brand name stylized suffix\">\n                rai\n            </span>\n            .in\n            <b class=\"text-[10px] text-pink-300\" data-kid=\"1-2-1-2\" data-name=\"brand star icon\">\n                ✦\n            </b>\n        </a>\n        <nav aria-label=\"Signed-in navigation\" class=\"flex items-center gap-1 rounded-full border border-slate-300/15 bg-[#081426]/70 p-1.5 shadow-lg shadow-slate-950/20 backdrop-blur\" data-kid=\"1-2-2\" data-name=\"primary navigation\">\n            <a class=\"rounded-full px-3 py-2 text-[11px] font-bold text-slate-300 no-underline\" data-kid=\"1-2-2-1\" data-name=\"nav link home\" href=\"#\">\n                Home\n            </a>\n            <a class=\"rounded-full px-3 py-2 text-[11px] font-bold text-slate-300 no-underline\" data-kid=\"1-2-2-2\" data-name=\"nav link community\" href=\"#\">\n                Community\n            </a>\n            <a class=\"rounded-full px-3 py-2 text-[11px] font-bold text-slate-300 no-underline\" data-kid=\"1-2-2-3\" data-name=\"nav link projects\" href=\"#\">\n                Projects\n            </a>\n            <a class=\"rounded-full bg-sky-400/10 px-3 py-2 text-[11px] font-bold text-sky-300 no-underline\" data-kid=\"1-2-2-4\" data-name=\"nav link arrai pay\" href=\"#\">\n                ARRAI Pay\n            </a>\n            <span class=\"mx-1 h-5 w-px bg-slate-400/20\" data-kid=\"1-2-2-5\" data-name=\"navigation divider\">\n            </span>\n            <a class=\"flex items-center gap-2 rounded-full px-2 py-1.5 text-[11px] font-bold text-[#fff7fb] no-underline\" data-kid=\"1-2-2-6\" data-name=\"user account link\" href=\"#\">\n                <span class=\"grid h-7 w-7 place-items-center rounded-full bg-gradient-to-br from-pink-300 to-indigo-300 text-[13px] text-slate-900\" data-kid=\"1-2-2-6-1\" data-name=\"user avatar placeholder\">\n                    A\n                </span>\n                <span data-kid=\"1-2-2-6-2\" data-name=\"user profile name\">\n                    Abhishek\n                </span>\n            </a>\n            <a class=\"rounded-full border border-pink-300/25 bg-pink-300/5 px-3 py-2 font-[DM_Mono] text-[9px] uppercase tracking-[.09em] text-pink-200 no-underline\" data-kid=\"1-2-2-7\" data-name=\"wallet status link\" href=\"#wallet\">\n                Wallet planned\n            </a>\n        </nav>\n    </header>\n    <main class=\"relative z-10 mx-auto w-[calc(100%-48px)] max-w-[1160px] pb-20 pt-14\" data-kid=\"1-3\" data-name=\"main content area\">\n        <div class=\"grid grid-cols-[1.1fr_.9fr] gap-12 border-b border-sky-200/15 pb-12\" data-kid=\"1-3-1\" data-name=\"hero header section\">\n            <section data-kid=\"1-3-1-1\" data-name=\"hero text block\">\n                <p class=\"mb-5 flex items-center gap-2 font-[DM_Mono] text-[11px] uppercase tracking-[.14em] text-sky-300\" data-kid=\"1-3-1-1-1\" data-name=\"status indicator container\">\n                    <span class=\"h-2 w-2 rounded-full border border-sky-300 shadow-[0_0_0_4px_rgba(56,189,248,.1)]\" data-kid=\"1-3-1-1-1-1\" data-name=\"status dot\">\n                    </span>\n                    Signed in · ARRAI Pay\n                </p>\n                <h1 class=\"max-w-[680px] text-[62px] font-extrabold leading-[.96] tracking-[-.075em]\" data-kid=\"1-3-1-1-2\" data-name=\"hero main headline\">\n                    Know what you can\n                    <br data-kid=\"1-3-1-1-2-1\" data-name=\"headline line break\"/>\n                    <em class=\"font-[Playfair_Display] font-semibold text-pink-300\" data-kid=\"1-3-1-1-2-2\" data-name=\"headline highlight text\">\n                        pay for today.\n                    </em>\n                </h1>\n                <p class=\"mt-7 max-w-[590px] text-[15px] leading-8 text-slate-300\" data-kid=\"1-3-1-1-3\" data-name=\"hero subheadline\">\n                    ARRAI Pay currently opens secure Razorpay checkout for supported payments. A stored-value ARRAI Wallet is not active yet—money paid today does not create a wallet balance.\n                </p>\n            </section>\n            <aside class=\"self-end border-l border-sky-200/20 pl-8\" data-kid=\"1-3-1-2\" data-name=\"wallet status card area\">\n                <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.12em] text-slate-400\" data-kid=\"1-3-1-2-1\" data-name=\"account section label\">\n                    Your account\n                </p>\n                <div class=\"mt-3 rounded-2xl border border-pink-300/25 bg-gradient-to-br from-[#1f2950] to-[#18233d] p-5 shadow-[0_18px_42px_rgba(2,6,23,.25)]\" data-kid=\"1-3-1-2-2\" data-name=\"wallet status card\" id=\"wallet\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-3-1-2-2-1\" data-name=\"wallet card header\">\n                        <span class=\"grid h-10 w-10 place-items-center rounded-xl bg-pink-300/15 text-xl text-pink-200\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"wallet icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-wallet\" data-kid=\"1-3-1-2-2-1-1-1\" data-name=\"wallet icon\">\n                            </i>\n                        </span>\n                        <span class=\"rounded-full border border-slate-200/15 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.08em] text-slate-300\" data-kid=\"1-3-1-2-2-1-2\" data-name=\"wallet status badge\">\n                            Not active\n                        </span>\n                    </div>\n                    <p class=\"mt-5 text-[12px] font-bold text-slate-200\" data-kid=\"1-3-1-2-2-2\" data-name=\"wallet label\">\n                        ARRAI Wallet\n                    </p>\n                    <p class=\"mt-1 text-[22px] font-extrabold tracking-[-.04em] text-white\" data-kid=\"1-3-1-2-2-3\" data-name=\"wallet balance text\">\n                        Balance unavailable\n                    </p>\n                    <p class=\"mt-3 text-[11px] leading-5 text-slate-400\" data-kid=\"1-3-1-2-2-4\" data-name=\"wallet description\">\n                        Balance and wallet history will appear here only after the wallet ledger is launched.\n                    </p>\n                </div>\n            </aside>\n        </div>\n        <section aria-labelledby=\"available-title\" class=\"py-12\" data-kid=\"1-3-2\" data-name=\"available payments section\">\n            <div class=\"mb-6 flex items-end justify-between gap-8\" data-kid=\"1-3-2-1\" data-name=\"payments section header\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"payments section title container\">\n                    <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.13em] text-lime-300\" data-kid=\"1-3-2-1-1-1\" data-name=\"payments section eyebrow\">\n                        Payments supported today\n                    </p>\n                    <h2 class=\"mt-2 text-[34px] font-extrabold tracking-[-.055em]\" data-kid=\"1-3-2-1-1-2\" data-name=\"payments section title\" id=\"available-title\">\n                        Available now\n                    </h2>\n                </div>\n                <p class=\"max-w-[350px] text-right text-[11px] leading-5 text-slate-400\" data-kid=\"1-3-2-1-2\" data-name=\"payments section description\">\n                    Every paid action opens Razorpay. ARRAI confirms a completed payment only after server-side verification.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-[1.18fr_.82fr] gap-4\" data-kid=\"1-3-2-2\" data-name=\"payment options grid\">\n                <article class=\"relative overflow-hidden rounded-3xl border border-sky-300/35 bg-gradient-to-br from-[#075985] via-[#183c72] to-[#312e81] p-7 shadow-[0_20px_60px_rgba(2,6,23,.28)]\" data-kid=\"1-3-2-2-1\" data-name=\"custom payment card\">\n                    <div class=\"absolute right-[-34px] top-[-44px] h-44 w-44 rounded-full bg-sky-200/15 blur-2xl\" data-kid=\"1-3-2-2-1-1\" data-name=\"card background orb\">\n                    </div>\n                    <div class=\"relative\" data-kid=\"1-3-2-2-1-2\" data-name=\"card content\">\n                        <div class=\"flex items-start justify-between\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"card header\">\n                            <span class=\"grid h-11 w-11 place-items-center rounded-2xl border border-white/15 bg-white/10 text-[22px] text-sky-100\" data-kid=\"1-3-2-2-1-2-1-1\" data-name=\"payment card icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-credit-card-pay\" data-kid=\"1-3-2-2-1-2-1-1-1\" data-name=\"credit card icon\">\n                                </i>\n                            </span>\n                            <span class=\"rounded-full bg-lime-300/15 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.08em] text-lime-200\" data-kid=\"1-3-2-2-1-2-1-2\" data-name=\"card status badge\">\n                                Available now\n                            </span>\n                        </div>\n                        <p class=\"mt-10 font-[DM_Mono] text-[10px] uppercase tracking-[.12em] text-sky-100/80\" data-kid=\"1-3-2-2-1-2-2\" data-name=\"card category label\">\n                            Custom payment\n                        </p>\n                        <h3 class=\"mt-2 text-[30px] font-extrabold tracking-[-.05em]\" data-kid=\"1-3-2-2-1-2-3\" data-name=\"card title\">\n                            Pay an amount\n                        </h3>\n                        <p class=\"mt-3 max-w-[480px] text-[12px] leading-6 text-sky-50/80\" data-kid=\"1-3-2-2-1-2-4\" data-name=\"card description\">\n                            Choose an amount, then open secure Razorpay checkout. ARRAI receives a verified payment result; this does not add money to a wallet.\n                        </p>\n                        <div class=\"mt-6 flex items-center justify-between border-t border-white/15 pt-5\" data-kid=\"1-3-2-2-1-2-5\" data-name=\"card footer\">\n                            <span class=\"text-[11px] text-sky-100/75\" data-kid=\"1-3-2-2-1-2-5-1\" data-name=\"card info text\">\n                                Razorpay checkout · server verification\n                            </span>\n                            <button class=\"rounded-xl bg-white px-4 py-3 text-[11px] font-extrabold text-[#172033] shadow-sm\" data-kid=\"1-3-2-2-1-2-5-2\" data-name=\"checkout button\" type=\"button\">\n                                Pay with Razorpay\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-2 text-[15px]\" data-kid=\"1-3-2-2-1-2-5-2-1\" data-name=\"external link icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"rounded-3xl border border-pink-300/35 bg-gradient-to-br from-[#2f1b49] to-[#172554] p-7 shadow-[0_20px_60px_rgba(2,6,23,.22)]\" data-kid=\"1-3-2-2-2\" data-name=\"gold membership card\">\n                    <div class=\"flex items-start justify-between\" data-kid=\"1-3-2-2-2-1\" data-name=\"membership card header\">\n                        <span class=\"grid h-11 w-11 place-items-center rounded-2xl border border-pink-200/20 bg-pink-300/15 text-[22px] text-pink-200\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"membership card icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-crown\" data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"crown icon\">\n                            </i>\n                        </span>\n                        <span class=\"rounded-full bg-lime-300/15 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.08em] text-lime-200\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"membership status badge\">\n                            Available now\n                        </span>\n                    </div>\n                    <p class=\"mt-9 font-[DM_Mono] text-[10px] uppercase tracking-[.12em] text-pink-200\" data-kid=\"1-3-2-2-2-2\" data-name=\"membership card category label\">\n                        Gold membership\n                    </p>\n                    <h3 class=\"mt-2 text-[30px] font-extrabold tracking-[-.05em]\" data-kid=\"1-3-2-2-2-3\" data-name=\"membership card title\">\n                        Gold VIP · ₹45\n                    </h3>\n                    <p class=\"mt-3 text-[12px] leading-6 text-slate-300\" data-kid=\"1-3-2-2-2-4\" data-name=\"membership card description\">\n                        One-time membership checkout through Razorpay. Gold access is granted after payment verification completes.\n                    </p>\n                    <button class=\"mt-6 w-full rounded-xl border border-pink-200/50 bg-pink-300 px-4 py-3 text-[11px] font-extrabold text-[#2d183f]\" data-kid=\"1-3-2-2-2-5\" data-name=\"membership checkout button\" type=\"button\">\n                        Pay ₹45 for Gold VIP\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-2 text-[15px]\" data-kid=\"1-3-2-2-2-5-1\" data-name=\"membership external link icon\">\n                        </i>\n                    </button>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"map-title\" class=\"border-y border-sky-200/15 py-12\" data-kid=\"1-3-3\" data-name=\"capability map section\">\n            <div class=\"grid grid-cols-[.76fr_1.24fr] gap-10\" data-kid=\"1-3-3-1\" data-name=\"capability map grid\">\n                <div data-kid=\"1-3-3-1-1\" data-name=\"map info panel\">\n                    <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.13em] text-pink-300\" data-kid=\"1-3-3-1-1-1\" data-name=\"map section eyebrow\">\n                        Capability map\n                    </p>\n                    <h2 class=\"mt-2 text-[34px] font-extrabold leading-none tracking-[-.055em]\" data-kid=\"1-3-3-1-1-2\" data-name=\"map section title\" id=\"map-title\">\n                        What ARRAI Pay\n                        <br data-kid=\"1-3-3-1-1-2-1\" data-name=\"map title line break\"/>\n                        can do today.\n                    </h2>\n                    <p class=\"mt-5 max-w-[300px] text-[12px] leading-6 text-slate-400\" data-kid=\"1-3-3-1-1-3\" data-name=\"map description\">\n                        Payment features are shown by real availability—not as a promise of an active financial account.\n                    </p>\n                    <div class=\"mt-7 rounded-xl border border-sky-200/15 bg-[#162238]/70 p-4\" data-kid=\"1-3-3-1-1-4\" data-name=\"map importance banner\">\n                        <p class=\"text-[11px] font-bold text-sky-200\" data-kid=\"1-3-3-1-1-4-1\" data-name=\"banner title\">\n                            Important\n                        </p>\n                        <p class=\"mt-1 text-[10px] leading-5 text-slate-400\" data-kid=\"1-3-3-1-1-4-2\" data-name=\"banner description\">\n                            You cannot add money to an ARRAI Wallet yet. Payments made today go through Razorpay.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"overflow-hidden rounded-2xl border border-sky-200/20 bg-[#121f35]/80 shadow-[0_20px_50px_rgba(2,6,23,.18)]\" data-kid=\"1-3-3-1-2\" data-name=\"capability status table\">\n                    <div class=\"grid grid-cols-[1.1fr_.62fr_.95fr] gap-4 border-b border-sky-200/15 bg-slate-950/20 px-5 py-3 font-[DM_Mono] text-[9px] uppercase tracking-[.1em] text-slate-400\" data-kid=\"1-3-3-1-2-1\" data-name=\"table header\">\n                        <span data-kid=\"1-3-3-1-2-1-1\" data-name=\"header column capability\">\n                            Capability\n                        </span>\n                        <span data-kid=\"1-3-3-1-2-1-2\" data-name=\"header column status\">\n                            Status\n                        </span>\n                        <span data-kid=\"1-3-3-1-2-1-3\" data-name=\"header column route\">\n                            Current route\n                        </span>\n                    </div>\n                    <div class=\"divide-y divide-sky-200/10\" data-kid=\"1-3-3-1-2-2\" data-name=\"table body\">\n                        <div class=\"grid grid-cols-[1.1fr_.62fr_.95fr] items-center gap-4 px-5 py-5\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"table row add money\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-3-1-2-2-1-1\" data-name=\"row icon container\">\n                                <span class=\"grid h-8 w-8 place-items-center rounded-lg bg-pink-300/10 text-pink-200\" data-kid=\"1-3-3-1-2-2-1-1-1\" data-name=\"plus icon\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-3-3-1-2-2-1-1-1-1\" data-name=\"plus symbol icon\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-3-3-1-2-2-1-1-2\" data-name=\"row content area\">\n                                    <b class=\"block text-[12px]\" data-kid=\"1-3-3-1-2-2-1-1-2-1\" data-name=\"row title\">\n                                        Add money\n                                    </b>\n                                    <small class=\"mt-1 block text-[10px] text-slate-400\" data-kid=\"1-3-3-1-2-2-1-1-2-2\" data-name=\"row subtitle\">\n                                        Top up an ARRAI Wallet\n                                    </small>\n                                </div>\n                            </div>\n                            <span class=\"w-fit rounded-full border border-slate-400/20 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.07em] text-slate-300\" data-kid=\"1-3-3-1-2-2-1-2\" data-name=\"row status badge\">\n                                Planned\n                            </span>\n                            <span class=\"text-[11px] text-slate-400\" data-kid=\"1-3-3-1-2-2-1-3\" data-name=\"row route text\">\n                                Not available\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[1.1fr_.62fr_.95fr] items-center gap-4 px-5 py-5\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"table row wallet spending\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-3-1-2-2-2-1\" data-name=\"row icon container\">\n                                <span class=\"grid h-8 w-8 place-items-center rounded-lg bg-pink-300/10 text-pink-200\" data-kid=\"1-3-3-1-2-2-2-1-1\" data-name=\"row wallet icon\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-wallet\" data-kid=\"1-3-3-1-2-2-2-1-1-1\" data-name=\"wallet icon\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-3-3-1-2-2-2-1-2\" data-name=\"row content area\">\n                                    <b class=\"block text-[12px]\" data-kid=\"1-3-3-1-2-2-2-1-2-1\" data-name=\"row title\">\n                                        Wallet spending\n                                    </b>\n                                    <small class=\"mt-1 block text-[10px] text-slate-400\" data-kid=\"1-3-3-1-2-2-2-1-2-2\" data-name=\"row subtitle\">\n                                        Use wallet across ARRAI\n                                    </small>\n                                </div>\n                            </div>\n                            <span class=\"w-fit rounded-full border border-slate-400/20 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.07em] text-slate-300\" data-kid=\"1-3-3-1-2-2-2-2\" data-name=\"row status badge\">\n                                Planned\n                            </span>\n                            <span class=\"text-[11px] text-slate-400\" data-kid=\"1-3-3-1-2-2-2-3\" data-name=\"row route text\">\n                                Not available\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[1.1fr_.62fr_.95fr] items-center gap-4 px-5 py-5\" data-kid=\"1-3-3-1-2-2-3\" data-name=\"table row upi scan\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-3-1-2-2-3-1\" data-name=\"row icon container\">\n                                <span class=\"grid h-8 w-8 place-items-center rounded-lg bg-pink-300/10 text-pink-200\" data-kid=\"1-3-3-1-2-2-3-1-1\" data-name=\"row scan icon\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-scan\" data-kid=\"1-3-3-1-2-2-3-1-1-1\" data-name=\"scan icon\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-3-3-1-2-2-3-1-2\" data-name=\"row content area\">\n                                    <b class=\"block text-[12px]\" data-kid=\"1-3-3-1-2-2-3-1-2-1\" data-name=\"row title\">\n                                        UPI scan & pay\n                                    </b>\n                                    <small class=\"mt-1 block text-[10px] text-slate-400\" data-kid=\"1-3-3-1-2-2-3-1-2-2\" data-name=\"row subtitle\">\n                                        Pay another person or merchant\n                                    </small>\n                                </div>\n                            </div>\n                            <span class=\"w-fit rounded-full border border-slate-400/20 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.07em] text-slate-300\" data-kid=\"1-3-3-1-2-2-3-2\" data-name=\"row status badge\">\n                                Planned\n                            </span>\n                            <span class=\"text-[11px] text-slate-400\" data-kid=\"1-3-3-1-2-2-3-3\" data-name=\"row route text\">\n                                Not available\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[1.1fr_.62fr_.95fr] items-center gap-4 px-5 py-5\" data-kid=\"1-3-3-1-2-2-4\" data-name=\"table row send to bank\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-3-1-2-2-4-1\" data-name=\"row icon container\">\n                                <span class=\"grid h-8 w-8 place-items-center rounded-lg bg-pink-300/10 text-pink-200\" data-kid=\"1-3-3-1-2-2-4-1-1\" data-name=\"row bank icon\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-building-bank\" data-kid=\"1-3-3-1-2-2-4-1-1-1\" data-name=\"building bank icon\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-3-3-1-2-2-4-1-2\" data-name=\"row content area\">\n                                    <b class=\"block text-[12px]\" data-kid=\"1-3-3-1-2-2-4-1-2-1\" data-name=\"row title\">\n                                        Send to bank\n                                    </b>\n                                    <small class=\"mt-1 block text-[10px] text-slate-400\" data-kid=\"1-3-3-1-2-2-4-1-2-2\" data-name=\"row subtitle\">\n                                        Bank-account payout\n                                    </small>\n                                </div>\n                            </div>\n                            <span class=\"w-fit rounded-full border border-slate-400/20 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.07em] text-slate-300\" data-kid=\"1-3-3-1-2-2-4-2\" data-name=\"row status badge\">\n                                Planned\n                            </span>\n                            <span class=\"text-[11px] text-slate-400\" data-kid=\"1-3-3-1-2-2-4-3\" data-name=\"row route text\">\n                                Not available\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-[1.1fr_.62fr_.95fr] items-center gap-4 px-5 py-5\" data-kid=\"1-3-3-1-2-2-5\" data-name=\"table row mobile recharge\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-3-1-2-2-5-1\" data-name=\"row icon container\">\n                                <span class=\"grid h-8 w-8 place-items-center rounded-lg bg-pink-300/10 text-pink-200\" data-kid=\"1-3-3-1-2-2-5-1-1\" data-name=\"row mobile icon\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-device-mobile\" data-kid=\"1-3-3-1-2-2-5-1-1-1\" data-name=\"mobile device icon\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"1-3-3-1-2-2-5-1-2\" data-name=\"row content area\">\n                                    <b class=\"block text-[12px]\" data-kid=\"1-3-3-1-2-2-5-1-2-1\" data-name=\"row title\">\n                                        Mobile recharge\n                                    </b>\n                                    <small class=\"mt-1 block text-[10px] text-slate-400\" data-kid=\"1-3-3-1-2-2-5-1-2-2\" data-name=\"row subtitle\">\n                                        Recharge mobile service\n                                    </small>\n                                </div>\n                            </div>\n                            <span class=\"w-fit rounded-full border border-slate-400/20 px-2.5 py-1 font-[DM_Mono] text-[9px] uppercase tracking-[.07em] text-slate-300\" data-kid=\"1-3-3-1-2-2-5-2\" data-name=\"row status badge\">\n                                Planned\n                            </span>\n                            <span class=\"text-[11px] text-slate-400\" data-kid=\"1-3-3-1-2-2-5-3\" data-name=\"row route text\">\n                                Not available\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"grid grid-cols-[1fr_.86fr] gap-8 py-12\" data-kid=\"1-3-4\" data-name=\"footer sections grid\">\n            <article class=\"rounded-2xl border border-sky-200/20 bg-[#162238]/70 p-6\" data-kid=\"1-3-4-1\" data-name=\"history status card\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-3-4-1-1\" data-name=\"history card header\">\n                    <div data-kid=\"1-3-4-1-1-1\" data-name=\"history card text block\">\n                        <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.12em] text-sky-300\" data-kid=\"1-3-4-1-1-1-1\" data-name=\"history eyebrow\">\n                            Payment history\n                        </p>\n                        <h2 class=\"mt-2 text-[27px] font-extrabold tracking-[-.05em]\" data-kid=\"1-3-4-1-1-1-2\" data-name=\"history title\">\n                            No wallet history yet.\n                        </h2>\n                    </div>\n                    <span class=\"grid h-10 w-10 place-items-center rounded-xl bg-sky-300/10 text-sky-200\" data-kid=\"1-3-4-1-1-2\" data-name=\"history icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-receipt-off\" data-kid=\"1-3-4-1-1-2-1\" data-name=\"history off icon\">\n                        </i>\n                    </span>\n                </div>\n                <p class=\"mt-4 max-w-[530px] text-[12px] leading-6 text-slate-400\" data-kid=\"1-3-4-1-2\" data-name=\"history description\">\n                    ARRAI Pay does not have a transaction ledger yet, so no wallet activity can be shown here. A Razorpay checkout confirmation is not wallet credit.\n                </p>\n            </article>\n            <aside class=\"rounded-2xl border border-pink-300/25 bg-gradient-to-r from-pink-300/10 to-indigo-300/10 p-6\" data-kid=\"1-3-4-2\" data-name=\"help contact card\">\n                <p class=\"font-[DM_Mono] text-[10px] uppercase tracking-[.12em] text-pink-200\" data-kid=\"1-3-4-2-1\" data-name=\"help eyebrow\">\n                    Need help?\n                </p>\n                <h2 class=\"mt-2 text-[25px] font-extrabold tracking-[-.05em]\" data-kid=\"1-3-4-2-2\" data-name=\"help title\">\n                    Paying for a service?\n                </h2>\n                <p class=\"mt-3 text-[12px] leading-6 text-slate-300\" data-kid=\"1-3-4-2-3\" data-name=\"help description\">\n                    Use custom checkout only after confirming the amount and purpose with ARRAI. Payment alone does not automatically create a service order.\n                </p>\n                <a class=\"mt-5 inline-flex items-center gap-2 text-[11px] font-extrabold text-sky-300 no-underline\" data-kid=\"1-3-4-2-4\" data-name=\"contact link\" href=\"#\">\n                    Contact ARRAI\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-3-4-2-4-1\" data-name=\"contact external link icon\">\n                    </i>\n                </a>\n            </aside>\n        </section>\n    </main>\n    <footer class=\"relative z-10 mx-auto flex w-[calc(100%-48px)] max-w-[1160px] items-center justify-between border-t border-sky-200/15 py-7\" data-kid=\"1-4\" data-name=\"page footer\">\n        <a class=\"text-[17px] font-extrabold text-[#fff7fb] no-underline\" data-kid=\"1-4-1\" data-name=\"footer brand identity\" href=\"#\">\n            ar\n            <span class=\"font-[Playfair_Display] italic\" data-kid=\"1-4-1-1\" data-name=\"footer brand stylized suffix\">\n                rai\n            </span>\n            .in\n        </a>\n        <p class=\"text-[10px] text-slate-500\" data-kid=\"1-4-2\" data-name=\"footer copyright info\">\n            ARRAI Pay · Razorpay checkout for available payments\n        </p>\n        <div class=\"flex gap-4 text-[10px] font-bold text-slate-400\" data-kid=\"1-4-3\" data-name=\"footer utility links\">\n            <a class=\"text-inherit no-underline\" data-kid=\"1-4-3-1\" data-name=\"footer link privacy\" href=\"#\">\n                Privacy\n            </a>\n            <a class=\"text-inherit no-underline\" data-kid=\"1-4-3-2\" data-name=\"footer link terms\" href=\"#\">\n                Terms\n            </a>\n        </div>\n    </footer>\n</div>\n<style>\n    @media (max-width: 850px){header nav a:not([href=\"#wallet\"]):not(:last-child){display:none}main>div:first-child,.grid{grid-template-columns:1fr!important}.grid{gap:20px!important}h1{font-size:48px!important}.text-right{text-align:left}.self-end{padding-left:0;border-left:0}.overflow-hidden>div{min-width:650px}.overflow-hidden{overflow-x:auto}.fixed{position:absolute}.w-\\[calc\\(100\\%-48px\\)\\]{width:calc(100% - 32px)}}\n</style>\n",
