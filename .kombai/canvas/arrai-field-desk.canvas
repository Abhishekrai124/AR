      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css\");\n@layer components {\n  .fo-grid { background-image: linear-gradient(rgba(205,173,112,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(205,173,112,.035) 1px, transparent 1px); background-size: 44px 44px; }\n  .fo-eyebrow { font: 500 .62rem/1.3 'DM Mono', monospace; letter-spacing: .105em; text-transform: uppercase; color: #d5ad6f; }\n  .fo-rule { border-color: rgba(205,173,112,.22); }\n  .fo-panel { border: 1px solid rgba(205,173,112,.23); background: linear-gradient(145deg, rgba(32,39,34,.96), rgba(25,31,27,.93)); }\n  .fo-kbd { border: 1px solid rgba(205,173,112,.4); border-bottom-width: 2px; border-radius: 4px; padding: 2px 6px; color: #eee9dc; background: #202722; font: 500 .66rem 'DM Mono', monospace; }\n  .fo-focus:focus-visible { outline: 2px solid #d5ad6f; outline-offset: 3px; }\n  .fo-route:hover { border-color: rgba(213,173,111,.62); background-color: rgba(213,173,111,.045); }\n  .fo-map-stage { background-color: #171d19; background-image: linear-gradient(rgba(205,173,112,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(205,173,112,.05) 1px, transparent 1px); background-size: 36px 36px; }\n  .fo-status-dot { box-shadow: 0 0 0 4px rgba(169,185,145,.09); }\n}\n@media (max-width: 760px) {\n  .fo-hide-mobile { display: none; }\n}\n</style>\n<div class=\"fo-grid min-h-screen bg-[#151a17] font-[Manrope] text-[#eee9dc]\" data-kid=\"1\">\n    <header class=\"border-b border-[#d5ad6f]/20 bg-[#151a17]/95\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1240px] items-center justify-between gap-6 px-7 py-4 max-[760px]:flex-col max-[760px]:items-start max-[760px]:gap-4 max-[760px]:px-5\" data-kid=\"1-1-1\">\n            <a aria-label=\"ARRAI Field Office member desk\" class=\"fo-focus flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" href=\"#member-desk\">\n                <span class=\"font-['Barlow_Condensed'] text-[1.85rem] font-bold leading-none tracking-[.06em] text-[#eee9dc]\" data-kid=\"1-1-1-1-1\">\n                    ARRAI\n                </span>\n                <span class=\"h-7 w-px bg-[#d5ad6f]/35\" data-kid=\"1-1-1-1-2\">\n                </span>\n                <span class=\"fo-eyebrow text-[.56rem] leading-[1.5]\" data-kid=\"1-1-1-1-3\">\n                    FIELD\n                    <br data-kid=\"1-1-1-1-3-1\"/>\n                    OFFICE\n                </span>\n            </a>\n            <div class=\"flex items-center gap-7 max-[760px]:w-full max-[760px]:justify-between max-[760px]:gap-2\" data-kid=\"1-1-1-2\">\n                <nav aria-label=\"Member navigation\" class=\"flex items-center gap-1\" data-kid=\"1-1-1-2-1\">\n                    <a aria-current=\"page\" class=\"fo-focus rounded-[4px] border border-[#d5ad6f]/25 bg-[#d5ad6f]/[.08] px-3 py-2 text-[.72rem] font-bold text-[#d5ad6f] no-underline\" data-kid=\"1-1-1-2-1-1\" href=\"#member-desk\">\n                        My desk\n                    </a>\n                    <a class=\"fo-focus rounded-[4px] px-3 py-2 text-[.72rem] font-semibold text-[#a6aaa1] no-underline hover:text-[#eee9dc]\" data-kid=\"1-1-1-2-1-2\" href=\"#case-desk\">\n                        Assigned cases\n                    </a>\n                    <a class=\"fo-focus rounded-[4px] px-3 py-2 text-[.72rem] font-semibold text-[#a6aaa1] no-underline hover:text-[#eee9dc]\" data-kid=\"1-1-1-2-1-3\" href=\"#public-calendar\">\n                        Calendar\n                    </a>\n                </nav>\n                <div class=\"flex shrink-0 items-center gap-3 border-l border-[#d5ad6f]/20 pl-5 max-[760px]:pl-3\" data-kid=\"1-1-1-2-2\">\n                    <span class=\"fo-status-dot h-2 w-2 rounded-full bg-[#a9b991]\" data-kid=\"1-1-1-2-2-1\">\n                    </span>\n                    <span class=\"fo-eyebrow text-[.54rem] text-[#a9b991]\" data-kid=\"1-1-1-2-2-2\">\n                        Verified member\n                    </span>\n                    <button aria-label=\"Sign out\" class=\"fo-focus ml-1 border-0 bg-transparent p-1 text-[.7rem] font-bold text-[#a6aaa1] hover:text-[#d5ad6f]\" data-kid=\"1-1-1-2-2-3\" type=\"button\">\n                        Sign out\n                    </button>\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1240px] px-7 pb-10 pt-10 max-[760px]:px-5 max-[760px]:pt-7\" data-kid=\"1-2\" id=\"member-desk\">\n        <div class=\"mb-7 flex items-end justify-between gap-8 max-[760px]:flex-col max-[760px]:items-start max-[760px]:gap-5\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <p class=\"fo-eyebrow mb-3 flex items-center gap-2\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"text-[#a6aaa1]\" data-kid=\"1-2-1-1-1-1\">\n                        Field office\n                    </span>\n                    <span class=\"text-[#6f746c]\" data-kid=\"1-2-1-1-1-2\">\n                        /\n                    </span>\n                    <span data-kid=\"1-2-1-1-1-3\">\n                        Member desk\n                    </span>\n                </p>\n                <h1 class=\"m-0 font-['Barlow_Condensed'] text-[3.15rem] font-semibold leading-[.96] tracking-[.015em] text-[#eee9dc] max-[760px]:text-[2.65rem]\" data-kid=\"1-2-1-1-2\">\n                    Your work,\n                    <em class=\"font-['Playfair_Display'] font-semibold not-italic text-[#d5ad6f]\" data-kid=\"1-2-1-1-2-1\">\n                        in context.\n                    </em>\n                </h1>\n                <p class=\"mb-0 mt-3 max-w-[620px] text-[.78rem] leading-[1.7] text-[#a6aaa1]\" data-kid=\"1-2-1-1-3\">\n                    Verified workspace · assigned case files remain private to your account.\n                </p>\n            </div>\n            <section aria-label=\"Local date and time\" class=\"fo-panel flex min-w-[340px] items-center gap-4 px-5 py-4 max-[760px]:min-w-0 max-[760px]:w-full\" data-kid=\"1-2-1-2\">\n                <span aria-hidden=\"true\" class=\"grid h-10 w-10 shrink-0 place-items-center border border-[#d5ad6f]/30 bg-[#d5ad6f]/[.07] text-[1.25rem] text-[#d5ad6f]\" data-kid=\"1-2-1-2-1\">\n                    <i class=\"ti ti-clock-hour-4\" data-kid=\"1-2-1-2-1-1\" style=\"width:22px;height:22px\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-2\">\n                    <p class=\"fo-eyebrow mb-1 text-[.55rem] text-[#a6aaa1]\" data-kid=\"1-2-1-2-2-1\">\n                        Your local date & time\n                    </p>\n                    <p class=\"m-0 text-[.68rem] font-semibold text-[#c9c8bd]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2\" data-name=\"local date display\" data-reason=\"text replaced every second by clock script\" id=\"local-date\">\n                        Browser date\n                    </p>\n                    <p class=\"mt-0.5 font-['DM_Mono'] text-[1.12rem] leading-none tracking-[.045em] text-[#eee9dc]\" data-kid=\"1-2-1-2-2-3\">\n                        <span data-dynamic=\"true\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"local time display\" data-reason=\"text replaced every second by clock script\" id=\"local-time\">\n                            --:--:--\n                        </span>\n                        <span class=\"ml-2 text-[.56rem] tracking-normal text-[#a6aaa1]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"local timezone display\" data-reason=\"text replaced every second by clock script\" id=\"local-zone\">\n                            local time\n                        </span>\n                    </p>\n                </div>\n                <span aria-label=\"Clock is live\" class=\"fo-status-dot h-1.5 w-1.5 shrink-0 rounded-full bg-[#a9b991]\" data-kid=\"1-2-1-2-3\">\n                </span>\n            </section>\n        </div>\n        <section aria-label=\"Member work and public schedule\" class=\"grid grid-cols-[1.12fr_.88fr] gap-4 max-[900px]:grid-cols-1\" data-kid=\"1-2-2\">\n            <article class=\"fo-panel relative min-h-[224px] overflow-hidden p-6 max-[760px]:p-5\" data-kid=\"1-2-2-1\" id=\"case-desk\">\n                <div class=\"mb-5 flex items-start justify-between gap-4\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <p class=\"fo-eyebrow mb-2\" data-kid=\"1-2-2-1-1-1-1\">\n                            01 · Private work\n                        </p>\n                        <h2 class=\"m-0 font-['Barlow_Condensed'] text-[1.72rem] font-semibold leading-none\" data-kid=\"1-2-2-1-1-1-2\">\n                            Assigned cases\n                        </h2>\n                    </div>\n                    <span class=\"inline-flex items-center gap-1.5 border border-[#d5ad6f]/20 px-2.5 py-1.5 text-[.57rem] font-semibold text-[#bdb7a8]\" data-kid=\"1-2-2-1-1-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-lock text-[.72rem] text-[#d5ad6f]\" data-kid=\"1-2-2-1-1-2-1\" style=\"width:12px;height:12px\">\n                        </i>\n                        Private to you\n                    </span>\n                </div>\n                <div class=\"flex min-h-[116px] items-center gap-4 border-t border-[#d5ad6f]/15 pt-4\" data-kid=\"1-2-2-1-2\">\n                    <span aria-hidden=\"true\" class=\"grid h-12 w-12 shrink-0 place-items-center border border-[#a6aaa1]/20 bg-[#151a17]/55 text-[1.3rem] text-[#a6aaa1]\" data-kid=\"1-2-2-1-2-1\">\n                        <i class=\"ti ti-folder-open\" data-kid=\"1-2-2-1-2-1-1\" style=\"width:23px;height:23px\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-2-2\">\n                        <p class=\"mb-1.5 text-[.9rem] font-bold text-[#eee9dc]\" data-kid=\"1-2-2-1-2-2-1\">\n                            No assigned cases yet\n                        </p>\n                        <p class=\"m-0 max-w-[500px] text-[.69rem] leading-[1.65] text-[#a6aaa1]\" data-kid=\"1-2-2-1-2-2-2\">\n                            When a case is assigned to your verified member account, its private summary and next steps will appear here.\n                        </p>\n                    </div>\n                    <a class=\"fo-focus hidden shrink-0 items-center gap-2 border-b border-[#d5ad6f]/50 pb-1 text-[.65rem] font-bold text-[#d5ad6f] no-underline sm:inline-flex\" data-kid=\"1-2-2-1-2-3\" href=\"#case-desk\">\n                        Case register\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-2-1-2-3-1\" style=\"width:13px;height:13px\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n            <article class=\"fo-panel min-h-[224px] p-6 max-[760px]:p-5\" data-kid=\"1-2-2-2\" id=\"public-calendar\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-2-2-1\">\n                    <div data-kid=\"1-2-2-2-1-1\">\n                        <p class=\"fo-eyebrow mb-2\" data-kid=\"1-2-2-2-1-1-1\">\n                            02 · Public schedule\n                        </p>\n                        <h2 class=\"m-0 font-['Barlow_Condensed'] text-[1.72rem] font-semibold leading-none\" data-kid=\"1-2-2-2-1-1-2\">\n                            Upcoming calendar\n                        </h2>\n                    </div>\n                    <span class=\"border border-[#a6aaa1]/20 px-2.5 py-1.5 text-[.56rem] font-semibold uppercase tracking-[.08em] text-[#a6aaa1]\" data-kid=\"1-2-2-2-1-2\">\n                        Public events\n                    </span>\n                </div>\n                <div class=\"mt-5 flex min-h-[104px] items-center gap-4 border-t border-[#d5ad6f]/15 pt-4\" data-kid=\"1-2-2-2-2\">\n                    <span aria-hidden=\"true\" class=\"grid h-11 w-11 shrink-0 place-items-center border border-[#d5ad6f]/25 bg-[#d5ad6f]/[.06] text-[1.2rem] text-[#d5ad6f]\" data-kid=\"1-2-2-2-2-1\">\n                        <i class=\"ti ti-calendar-event\" data-kid=\"1-2-2-2-2-1-1\" style=\"width:21px;height:21px\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-2-2-2\">\n                        <p class=\"mb-1 text-[.77rem] font-bold text-[#eee9dc]\" data-kid=\"1-2-2-2-2-2-1\">\n                            No event preview loaded\n                        </p>\n                        <p class=\"m-0 text-[.65rem] leading-[1.6] text-[#a6aaa1]\" data-kid=\"1-2-2-2-2-2-2\">\n                            This preview shows only public calendar events—not private appointments.\n                        </p>\n                    </div>\n                </div>\n                <a class=\"fo-focus mt-2 inline-flex items-center gap-2 text-[.64rem] font-bold text-[#d5ad6f] no-underline hover:text-[#eee9dc]\" data-kid=\"1-2-2-2-3\" href=\"#public-calendar\">\n                    Open public calendar\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-3-1\" style=\"width:13px;height:13px\">\n                    </i>\n                </a>\n            </article>\n        </section>\n        <section aria-labelledby=\"exploration-title\" class=\"mt-11\" data-kid=\"1-2-3\">\n            <div class=\"mb-5 flex items-end justify-between gap-6 max-[760px]:items-start max-[760px]:flex-col\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <p class=\"fo-eyebrow mb-2\" data-kid=\"1-2-3-1-1-1\">\n                        Field reference · optional routes\n                    </p>\n                    <h2 class=\"m-0 font-['Barlow_Condensed'] text-[2.05rem] font-semibold leading-none\" data-kid=\"1-2-3-1-1-2\" id=\"exploration-title\">\n                        Earth, then farther.\n                    </h2>\n                </div>\n                <p class=\"mb-0 max-w-[415px] text-[.7rem] leading-[1.65] text-[#a6aaa1]\" data-kid=\"1-2-3-1-2\">\n                    Choose a view by its source and scope. A connection check is not a map, and an educational model is not a live feed.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-[1.45fr_.85fr] gap-4 max-[900px]:grid-cols-1\" data-kid=\"1-2-3-2\">\n                <article class=\"fo-route group relative overflow-hidden border border-[#d5ad6f]/35 bg-[#202722]/85 p-6 transition-colors max-[760px]:p-5\" data-kid=\"1-2-3-2-1\">\n                    <div class=\"absolute right-6 top-5 font-['DM_Mono'] text-[.59rem] tracking-[.12em] text-[#d5ad6f]/70\" data-kid=\"1-2-3-2-1-1\">\n                        ROUTE 01\n                    </div>\n                    <div class=\"flex h-full gap-5 max-[550px]:flex-col\" data-kid=\"1-2-3-2-1-2\">\n                        <div aria-hidden=\"true\" class=\"grid h-[62px] w-[62px] shrink-0 place-items-center border border-[#d5ad6f]/30 bg-[#151a17] text-[1.8rem] text-[#d5ad6f]\" data-kid=\"1-2-3-2-1-2-1\">\n                            <i class=\"ti ti-world\" data-kid=\"1-2-3-2-1-2-1-1\" style=\"width:31px;height:31px\">\n                            </i>\n                        </div>\n                        <div class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-2-3-2-1-2-2\">\n                            <p class=\"fo-eyebrow mb-2 text-[.57rem] text-[#a6aaa1]\" data-kid=\"1-2-3-2-1-2-2-1\">\n                                Earth view · map opens on request\n                            </p>\n                            <h3 class=\"m-0 font-['Barlow_Condensed'] text-[1.78rem] font-semibold leading-none\" data-kid=\"1-2-3-2-1-2-2-2\">\n                                Earth map\n                            </h3>\n                            <p class=\"mb-4 mt-2 max-w-[540px] text-[.7rem] leading-[1.7] text-[#a6aaa1]\" data-kid=\"1-2-3-2-1-2-2-3\">\n                                A geographic view lives at the foot of this page. It starts closed; no map tiles or location marker are loaded by default.\n                            </p>\n                            <a class=\"fo-focus mt-auto inline-flex w-fit items-center gap-2 border-b border-[#d5ad6f]/60 pb-1 text-[.67rem] font-bold text-[#d5ad6f] no-underline\" data-kid=\"1-2-3-2-1-2-2-4\" href=\"#earth-map\">\n                                Go to Earth map\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-down\" data-kid=\"1-2-3-2-1-2-2-4-1\" style=\"width:14px;height:14px\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"fo-route group relative border border-[#a6aaa1]/20 bg-[#202722]/55 p-6 transition-colors max-[760px]:p-5\" data-kid=\"1-2-3-2-2\">\n                    <div class=\"absolute right-6 top-5 font-['DM_Mono'] text-[.59rem] tracking-[.12em] text-[#a6aaa1]/70\" data-kid=\"1-2-3-2-2-1\">\n                        ROUTE 02\n                    </div>\n                    <div class=\"flex h-full gap-4 max-[550px]:flex-col\" data-kid=\"1-2-3-2-2-2\">\n                        <div aria-hidden=\"true\" class=\"grid h-[52px] w-[52px] shrink-0 place-items-center border border-[#a6aaa1]/25 bg-[#151a17]/70 text-[1.5rem] text-[#a9b991]\" data-kid=\"1-2-3-2-2-2-1\">\n                            <i class=\"ti ti-telescope\" data-kid=\"1-2-3-2-2-2-1-1\" style=\"width:25px;height:25px\">\n                            </i>\n                        </div>\n                        <div class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-2-3-2-2-2-2\">\n                            <p class=\"fo-eyebrow mb-2 text-[.57rem] text-[#a6aaa1]\" data-kid=\"1-2-3-2-2-2-2-1\">\n                                Separate educational view\n                            </p>\n                            <h3 class=\"m-0 font-['Barlow_Condensed'] text-[1.55rem] font-semibold leading-none\" data-kid=\"1-2-3-2-2-2-2-2\">\n                                Solar system & space science\n                            </h3>\n                            <p class=\"mb-4 mt-2 text-[.67rem] leading-[1.65] text-[#a6aaa1]\" data-kid=\"1-2-3-2-2-2-2-3\">\n                                An educational model; sourced observations should carry their source and observation time. No live-universe feed is shown here.\n                            </p>\n                            <button aria-label=\"Open the separate solar system and space science view\" class=\"fo-focus mt-auto inline-flex w-fit items-center gap-2 border-0 border-b border-[#a9b991]/55 bg-transparent pb-1 text-left text-[.65rem] font-bold text-[#a9b991]\" data-kid=\"1-2-3-2-2-2-2-4\" type=\"button\">\n                                Open space-science view\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-2-3-2-2-2-2-4-1\" style=\"width:13px;height:13px\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </article>\n            </div>\n            <article class=\"mt-4 flex items-center gap-4 border border-[#d5ad6f]/15 bg-[#202722]/40 px-5 py-4 max-[600px]:items-start max-[600px]:flex-col\" data-kid=\"1-2-3-3\">\n                <span aria-hidden=\"true\" class=\"grid h-10 w-10 shrink-0 place-items-center border border-[#d77a59]/35 bg-[#d77a59]/[.07] text-[1.2rem] text-[#d77a59]\" data-kid=\"1-2-3-3-1\">\n                    <i class=\"ti ti-message-circle-2\" data-kid=\"1-2-3-3-1-1\" style=\"width:21px;height:21px\">\n                    </i>\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-3-2\">\n                    <p class=\"fo-eyebrow mb-1 text-[.56rem] text-[#d77a59]\" data-kid=\"1-2-3-3-2-1\">\n                        Route 03 · Site guidance\n                    </p>\n                    <h3 class=\"m-0 text-[.8rem] font-extrabold\" data-kid=\"1-2-3-3-2-2\">\n                        Ask AR about site navigation\n                    </h3>\n                    <p class=\"mb-0 mt-1 text-[.65rem] leading-[1.55] text-[#a6aaa1]\" data-kid=\"1-2-3-3-2-3\">\n                        AR can explain public pages and dashboard controls. It cannot access or investigate your private case files.\n                    </p>\n                </div>\n                <button class=\"fo-focus shrink-0 border border-[#d77a59]/40 bg-[#d77a59]/[.08] px-4 py-2.5 text-[.64rem] font-bold text-[#e9b29a] hover:bg-[#d77a59]/[.16] max-[600px]:w-full\" data-kid=\"1-2-3-3-3\" type=\"button\">\n                    Ask AR\n                    <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-2-3-3-3-1\">\n                        ↗\n                    </span>\n                </button>\n            </article>\n        </section>\n        <section aria-labelledby=\"connection-title\" class=\"mt-11\" data-kid=\"1-2-4\">\n            <div class=\"fo-panel p-6 max-[760px]:p-5\" data-kid=\"1-2-4-1\">\n                <div class=\"mb-5 flex items-start justify-between gap-5 max-[600px]:flex-col\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <p class=\"fo-eyebrow mb-2\" data-kid=\"1-2-4-1-1-1-1\">\n                            Optional · self diagnostics only\n                        </p>\n                        <h2 class=\"m-0 font-['Barlow_Condensed'] text-[1.8rem] font-semibold leading-none\" data-kid=\"1-2-4-1-1-1-2\" id=\"connection-title\">\n                            My current connection\n                        </h2>\n                        <p class=\"mb-0 mt-2 max-w-[680px] text-[.68rem] leading-[1.65] text-[#a6aaa1]\" data-kid=\"1-2-4-1-1-1-3\">\n                            Nothing has been checked. A lookup is available only after you request it, and only for this browser’s current connection.\n                        </p>\n                    </div>\n                    <button class=\"fo-focus inline-flex shrink-0 items-center gap-2 border border-[#d5ad6f]/60 bg-[#d5ad6f] px-4 py-3 text-[.65rem] font-extrabold text-[#171914] hover:bg-[#e4c48f] max-[600px]:w-full max-[600px]:justify-center\" data-kid=\"1-2-4-1-1-2\" id=\"check-connection\" type=\"button\">\n                        Check my connection\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-4-1-1-2-1\" style=\"width:14px;height:14px\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"grid grid-cols-4 border-y border-[#d5ad6f]/15 max-[760px]:grid-cols-2 max-[470px]:grid-cols-1\" data-kid=\"1-2-4-1-2\">\n                    <div class=\"border-r border-[#d5ad6f]/15 px-4 py-3.5 first:pl-0 max-[760px]:border-b max-[760px]:pl-0 max-[470px]:border-r-0\" data-kid=\"1-2-4-1-2-1\">\n                        <p class=\"fo-eyebrow mb-2 text-[.52rem] text-[#a6aaa1]\" data-kid=\"1-2-4-1-2-1-1\">\n                            Public IP\n                        </p>\n                        <p class=\"m-0 font-['DM_Mono'] text-[.81rem] tracking-[.06em] text-[#cbc8bc]\" data-kid=\"1-2-4-1-2-1-2\">\n                            •••.•••.•••.•••\n                        </p>\n                        <p class=\"mb-0 mt-1 text-[.58rem] text-[#858a81]\" data-kid=\"1-2-4-1-2-1-3\">\n                            Not checked\n                        </p>\n                    </div>\n                    <div class=\"border-r border-[#d5ad6f]/15 px-4 py-3.5 max-[760px]:border-b max-[760px]:pl-0 max-[470px]:border-r-0\" data-kid=\"1-2-4-1-2-2\">\n                        <p class=\"fo-eyebrow mb-2 text-[.52rem] text-[#a6aaa1]\" data-kid=\"1-2-4-1-2-2-1\">\n                            Approximate region\n                        </p>\n                        <p class=\"m-0 text-[.74rem] font-bold text-[#cbc8bc]\" data-kid=\"1-2-4-1-2-2-2\">\n                            Not available\n                        </p>\n                        <p class=\"mb-0 mt-1 text-[.58rem] text-[#858a81]\" data-kid=\"1-2-4-1-2-2-3\">\n                            Not a precise location\n                        </p>\n                    </div>\n                    <div class=\"border-r border-[#d5ad6f]/15 px-4 py-3.5 max-[760px]:border-b-0 max-[760px]:border-r-0 max-[760px]:pl-0\" data-kid=\"1-2-4-1-2-3\">\n                        <p class=\"fo-eyebrow mb-2 text-[.52rem] text-[#a6aaa1]\" data-kid=\"1-2-4-1-2-3-1\">\n                            Network provider\n                        </p>\n                        <p class=\"m-0 text-[.74rem] font-bold text-[#cbc8bc]\" data-kid=\"1-2-4-1-2-3-2\">\n                            Not checked\n                        </p>\n                        <p class=\"mb-0 mt-1 text-[.58rem] text-[#858a81]\" data-kid=\"1-2-4-1-2-3-3\">\n                            Shown only if returned\n                        </p>\n                    </div>\n                    <div class=\"px-4 py-3.5 max-[760px]:pl-0\" data-kid=\"1-2-4-1-2-4\">\n                        <p class=\"fo-eyebrow mb-2 text-[.52rem] text-[#a6aaa1]\" data-kid=\"1-2-4-1-2-4-1\">\n                            VPN / proxy\n                        </p>\n                        <p class=\"m-0 text-[.74rem] font-bold text-[#cbc8bc]\" data-kid=\"1-2-4-1-2-4-2\">\n                            Estimate not run\n                        </p>\n                        <p class=\"mb-0 mt-1 text-[.58rem] text-[#858a81]\" data-kid=\"1-2-4-1-2-4-3\">\n                            Never a definitive verdict\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-4 flex items-start justify-between gap-6 max-[760px]:flex-col max-[760px]:gap-3\" data-kid=\"1-2-4-1-3\">\n                    <label class=\"flex items-start gap-2.5 text-[.64rem] leading-[1.55] text-[#a6aaa1]\" data-kid=\"1-2-4-1-3-1\">\n                        <input class=\"mt-0.5 accent-[#d5ad6f]\" data-kid=\"1-2-4-1-3-1-1\" disabled=\"\" id=\"map-self-marker\" type=\"checkbox\"/>\n                        Show my approximate region on Earth map\n                        <span class=\"text-[#747a72]\" data-kid=\"1-2-4-1-3-1-2\">\n                            · off until a region is available\n                        </span>\n                    </label>\n                    <p class=\"m-0 max-w-[580px] text-[.59rem] leading-[1.65] text-[#858a81]\" data-kid=\"1-2-4-1-3-2\">\n                        IP-based estimates describe this connection, not another person. They do not identify someone or confirm an exact location; VPN/proxy results are uncertain. No third-party IP search.\n                    </p>\n                </div>\n                <p aria-live=\"polite\" class=\"fo-eyebrow mb-0 mt-3 min-h-3 text-[.5rem] text-[#a6aaa1]\" data-dynamic=\"true\" data-kid=\"1-2-4-1-4\" data-name=\"connection status feedback\" data-reason=\"text content updated by script on interaction\" id=\"connection-feedback\">\n                    Design preview · no connection lookup has run.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"earth-map-title\" class=\"mt-4 border border-[#d5ad6f]/35 bg-[#202722]/70\" data-kid=\"1-2-5\" id=\"earth-map\">\n            <div class=\"flex items-start justify-between gap-8 p-6 max-[760px]:flex-col max-[760px]:gap-5 max-[760px]:p-5\" data-kid=\"1-2-5-1\">\n                <div class=\"flex min-w-0 items-start gap-4\" data-kid=\"1-2-5-1-1\">\n                    <span aria-hidden=\"true\" class=\"grid h-11 w-11 shrink-0 place-items-center border border-[#d5ad6f]/30 bg-[#151a17] text-[1.35rem] text-[#d5ad6f]\" data-kid=\"1-2-5-1-1-1\">\n                        <i class=\"ti ti-world\" data-kid=\"1-2-5-1-1-1-1\" style=\"width:23px;height:23px\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-5-1-1-2\">\n                        <div class=\"mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1\" data-kid=\"1-2-5-1-1-2-1\">\n                            <p class=\"fo-eyebrow mb-0 text-[.56rem]\" data-kid=\"1-2-5-1-1-2-1-1\">\n                                Earth view · map shelf\n                            </p>\n                            <span class=\"border border-[#a6aaa1]/20 px-2 py-0.5 font-['DM_Mono'] text-[.49rem] tracking-[.08em] text-[#a6aaa1]\" data-kid=\"1-2-5-1-1-2-1-2\">\n                                CLOSED BY DEFAULT\n                            </span>\n                        </div>\n                        <h2 class=\"m-0 font-['Barlow_Condensed'] text-[1.75rem] font-semibold leading-none\" data-kid=\"1-2-5-1-1-2-2\" id=\"earth-map-title\">\n                            Explore Earth\n                        </h2>\n                        <p class=\"mb-0 mt-2 max-w-[700px] text-[.67rem] leading-[1.65] text-[#a6aaa1]\" data-kid=\"1-2-5-1-1-2-3\">\n                            The map is separate from connection diagnostics. It opens only when requested; any self-region marker is a separate, optional choice and starts off.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex shrink-0 items-center gap-2 max-[760px]:w-full\" data-kid=\"1-2-5-1-2\">\n                    <button aria-controls=\"earth-map-content\" aria-expanded=\"false\" class=\"fo-focus inline-flex items-center gap-2 border border-[#d5ad6f] bg-[#d5ad6f] px-4 py-3 text-[.65rem] font-extrabold text-[#171914] hover:bg-[#e4c48f] max-[760px]:flex-1 max-[760px]:justify-center\" data-dynamic=\"true\" data-kid=\"1-2-5-1-2-1\" data-name=\"toggle map visibility button\" data-reason=\"aria-expanded attribute and button text updated by script\" id=\"map-toggle\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-2\" data-kid=\"1-2-5-1-2-1-1\" style=\"width:15px;height:15px\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"toggle map button label\" data-reason=\"text content updated by script\">\n                            Show map\n                        </span>\n                    </button>\n                    <button aria-label=\"Expand the map area to fill the page\" class=\"fo-focus inline-flex items-center gap-2 border border-[#d5ad6f]/30 bg-transparent px-3 py-3 text-[.63rem] font-bold text-[#bdb7a8] hover:border-[#d5ad6f]/70 hover:text-[#eee9dc] max-[760px]:flex-1 max-[760px]:justify-center\" data-kid=\"1-2-5-1-2-2\" id=\"map-expand\" type=\"button\">\n                        Expand map\n                        <i aria-hidden=\"true\" class=\"ti ti-arrows-maximize\" data-kid=\"1-2-5-1-2-2-1\" style=\"width:14px;height:14px\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex items-center justify-between gap-4 border-t border-[#d5ad6f]/20 px-6 py-3 max-[760px]:flex-col max-[760px]:items-start max-[760px]:px-5\" data-kid=\"1-2-5-2\">\n                <p class=\"m-0 flex items-center gap-2 text-[.59rem] leading-[1.55] text-[#a6aaa1]\" data-kid=\"1-2-5-2-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-info-circle text-[#d5ad6f]\" data-kid=\"1-2-5-2-1-1\" style=\"width:14px;height:14px\">\n                    </i>\n                    F11 enters or exits\n                    <strong class=\"font-bold text-[#c9c8bd]\" data-kid=\"1-2-5-2-1-2\">\n                        browser\n                    </strong>\n                    full-screen—it affects the whole browser window.\n                </p>\n                <p class=\"m-0 text-[.57rem] text-[#858a81]\" data-kid=\"1-2-5-2-2\">\n                    Map source and tiles are not connected in this design preview.\n                </p>\n            </div>\n            <div aria-live=\"polite\" class=\"fo-map-stage hidden border-t border-[#d5ad6f]/20\" data-dynamic=\"true\" data-kid=\"1-2-5-3\" data-name=\"earth map content section\" data-reason=\"hidden class toggled by script on button interaction\" id=\"earth-map-content\">\n                <div class=\"grid min-h-[300px] place-items-center p-10 text-center max-[760px]:min-h-[230px] max-[760px]:p-6\" data-kid=\"1-2-5-3-1\">\n                    <div class=\"max-w-[460px]\" data-kid=\"1-2-5-3-1-1\">\n                        <span aria-hidden=\"true\" class=\"mx-auto mb-4 grid h-12 w-12 place-items-center border border-[#d5ad6f]/30 bg-[#151a17] text-[1.35rem] text-[#d5ad6f]\" data-kid=\"1-2-5-3-1-1-1\">\n                            <i class=\"ti ti-world\" data-kid=\"1-2-5-3-1-1-1-1\" style=\"width:24px;height:24px\">\n                            </i>\n                        </span>\n                        <p class=\"fo-eyebrow mb-2 text-[.53rem]\" data-kid=\"1-2-5-3-1-1-2\">\n                            No geographic data loaded\n                        </p>\n                        <p class=\"mb-0 text-[.72rem] leading-[1.7] text-[#a6aaa1]\" data-kid=\"1-2-5-3-1-1-3\">\n                            This preview intentionally draws no map, tiles, coordinates, or observations. A verified map source must be connected before geographic detail can appear.\n                        </p>\n                        <p class=\"mb-0 mt-3 text-[.6rem] font-semibold text-[#c9c8bd]\" data-kid=\"1-2-5-3-1-1-4\">\n                            No location marker is shown.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#d5ad6f]/15 bg-[#151a17]/80\" data-kid=\"1-3\">\n        <div class=\"mx-auto flex max-w-[1240px] items-center justify-between gap-5 px-7 py-5 max-[760px]:flex-col max-[760px]:items-start max-[760px]:px-5\" data-kid=\"1-3-1\">\n            <span class=\"font-['Barlow_Condensed'] text-[1.15rem] font-bold tracking-[.08em] text-[#b9b6aa]\" data-kid=\"1-3-1-1\">\n                ARRAI\n                <span class=\"ml-1 font-['DM_Mono'] text-[.48rem] font-normal tracking-[.1em] text-[#d5ad6f]\" data-kid=\"1-3-1-1-1\">\n                    FIELD OFFICE\n                </span>\n            </span>\n            <p class=\"m-0 text-[.57rem] leading-[1.6] text-[#858a81]\" data-kid=\"1-3-1-2\">\n                Private case work stays in the case register · Public events stay public · Connection estimates stay approximate\n            </p>\n            <span class=\"fo-eyebrow text-[.51rem] text-[#858a81]\" data-kid=\"1-3-1-3\">\n                Member desk · 2026\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    (() => {\n  const dateNode = document.getElementById('local-date');\n  const timeNode = document.getElementById('local-time');\n  const zoneNode = document.getElementById('local-zone');\n  const clock = () => {\n    const now = new Date();\n    dateNode.textContent = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }).format(now);\n    timeNode.textContent = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(now);\n    zoneNode.textContent = new Intl.DateTimeFormat().resolvedOptions().timeZone || 'local';\n  };\n  clock();\n  window.setInterval(clock, 1000);\n\n  const mapToggle = document.getElementById('map-toggle');\n  const mapContent = document.getElementById('earth-map-content');\n  const mapExpand = document.getElementById('map-expand');\n  mapToggle.addEventListener('click', () => {\n    const isOpening = mapContent.classList.contains('hidden');\n    mapContent.classList.toggle('hidden', !isOpening);\n    mapToggle.setAttribute('aria-expanded', String(isOpening));\n    mapToggle.querySelector('span').textContent = isOpening ? 'Hide map' : 'Show map';\n    if (isOpening) mapContent.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n  });\n  mapExpand.addEventListener('click', async () => {\n    try {\n      if (document.fullscreenElement) await document.exitFullscreen();\n      else if (!mapContent.classList.contains('hidden')) await mapContent.requestFullscreen();\n      else {\n        const feedback = document.getElementById('connection-feedback');\n        feedback.textContent = 'Open the map first; Expand map enlarges only the map area. F11 affects the whole browser.';\n        mapToggle.focus();\n      }\n    } catch (_) {\n      document.getElementById('connection-feedback').textContent = 'This browser did not allow in-page map expansion. F11 still toggles browser full-screen.';\n    }\n  });\n  document.getElementById('check-connection').addEventListener('click', () => {\n    document.getElementById('connection-feedback').textContent = 'Design preview only · no connection lookup was sent and no IP details were received.';\n  });\n})();\n</script>\n",
