    "var_7d8b7ded77ab": {
      "type": "variant",
      "label": "03 · Earth & Space Index",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
