      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');\n.field-desk {\n  --desk-bg: #151a17;\n  --desk-panel: #202722;\n  --desk-panel-soft: rgba(32, 39, 34, .62);\n  --desk-ink: #eee9dc;\n  --desk-muted: #a6aaa1;\n  --desk-brass: #d5ad6f;\n  --desk-olive: #a9b991;\n  --desk-rust: #d77a59;\n  --desk-line: rgba(205, 173, 112, .22);\n  min-height: 100vh;\n  color: var(--desk-ink);\n  background-color: var(--desk-bg);\n  background-image: linear-gradient(rgba(205,173,112,.028) 1px, transparent 1px), linear-gradient(90deg, rgba(205,173,112,.028) 1px, transparent 1px), radial-gradient(ellipse at 10% -12%, rgba(169,185,145,.09), transparent 35%);\n  background-size: 44px 44px, 44px 44px, auto;\n  font-family: Manrope, Arial, sans-serif;\n  overflow: hidden;\n}\n.field-desk * { box-sizing: border-box; }\n.field-desk button, .field-desk a, .field-desk summary { -webkit-tap-highlight-color: transparent; }\n.field-desk button { font: inherit; }\n.fd-wrap { width: min(1280px, calc(100% - 64px)); margin: 0 auto; }\n.fd-mono { font-family: 'DM Mono', monospace; }\n.fd-topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; border-bottom: 1px solid var(--desk-line); }\n.fd-brand { display: flex; align-items: baseline; gap: 11px; flex: 0 0 auto; color: var(--desk-ink); text-decoration: none; }\n.fd-brand b { font: 700 1.65rem 'Barlow Condensed', sans-serif; letter-spacing: .05em; }\n.fd-brand span { color: var(--desk-brass); font: 500 .58rem 'DM Mono', monospace; letter-spacing: .12em; }\n.fd-nav { display: flex; align-items: center; gap: 4px; padding: 5px; border: 1px solid var(--desk-line); border-radius: 4px; background: rgba(21,26,23,.76); }\n.fd-nav a { padding: 9px 13px; border-radius: 3px; color: var(--desk-muted); font-size: .69rem; font-weight: 700; text-decoration: none; white-space: nowrap; }\n.fd-nav a[aria-current='page'] { color: var(--desk-brass); background: rgba(213,173,111,.1); }\n.fd-account { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; }\n.fd-verified { display: inline-flex; align-items: center; gap: 8px; color: var(--desk-olive); font: 500 .57rem 'DM Mono', monospace; letter-spacing: .06em; white-space: nowrap; }\n.fd-verified i { width: 7px; height: 7px; border: 1px solid var(--desk-olive); border-radius: 50%; box-shadow: 0 0 0 3px rgba(169,185,145,.1); }\n.fd-logout { padding: 8px 11px; border: 1px solid var(--desk-line); border-radius: 3px; color: var(--desk-muted); background: transparent; font-size: .64rem; font-weight: 700; cursor: pointer; }\n.fd-page { padding-top: 46px; padding-bottom: 58px; }\n.fd-pagehead { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin: 0 0 28px; }\n.fd-kicker { display: flex; align-items: center; gap: 9px; margin: 0 0 11px; color: var(--desk-brass); font: 500 .59rem 'DM Mono', monospace; letter-spacing: .11em; text-transform: uppercase; }\n.fd-kicker::before { content: ''; width: 7px; height: 7px; border: 1px solid var(--desk-brass); border-radius: 50%; }\n.fd-pagehead h1 { margin: 0; color: var(--desk-ink); font: 600 clamp(2.7rem, 4vw, 4rem)/.94 'Barlow Condensed', sans-serif; letter-spacing: .005em; }\n.fd-pagehead h1 em { color: var(--desk-brass); font-style: normal; }\n.fd-pagehead-copy { max-width: 525px; margin: 12px 0 0; color: var(--desk-muted); font-size: .75rem; line-height: 1.65; }\n.fd-member-id { min-width: 216px; padding: 13px 15px; border-left: 1px solid var(--desk-brass); background: linear-gradient(90deg, rgba(213,173,111,.08), transparent); }\n.fd-member-id small { display: block; margin-bottom: 5px; color: var(--desk-muted); font: 400 .53rem 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }\n.fd-member-id b { color: var(--desk-ink); font: 600 1.05rem 'Barlow Condensed', sans-serif; letter-spacing: .03em; }\n.fd-main-grid { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(310px, .83fr); gap: 19px; align-items: stretch; }\n.fd-case-panel { min-height: 340px; display: flex; flex-direction: column; border: 1px solid var(--desk-line); background: linear-gradient(145deg, rgba(32,39,34,.94), rgba(25,31,27,.92)); }\n.fd-panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 17px 20px; border-bottom: 1px solid var(--desk-line); }\n.fd-panel-heading .fd-kicker { margin: 0; }\n.fd-panel-heading h2 { margin: 5px 0 0; color: var(--desk-ink); font: 600 1.55rem 'Barlow Condensed', sans-serif; letter-spacing: .02em; }\n.fd-label-tag { padding: 6px 8px; border: 1px solid var(--desk-line); color: var(--desk-muted); font: 400 .5rem 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }\n.fd-case-empty { display: grid; grid-template-columns: 104px 1fr; gap: 23px; align-items: center; flex: 1; padding: 36px 34px; }\n.fd-empty-mark { display: grid; place-items: center; width: 84px; height: 84px; border: 1px solid rgba(213,173,111,.45); border-radius: 50%; color: var(--desk-brass); font: 500 .58rem 'DM Mono', monospace; letter-spacing: .07em; position: relative; }\n.fd-empty-mark::before, .fd-empty-mark::after { position: absolute; content: ''; background: rgba(213,173,111,.4); }\n.fd-empty-mark::before { width: 1px; height: 106px; }\n.fd-empty-mark::after { width: 106px; height: 1px; }\n.fd-case-empty h3 { margin: 0 0 8px; color: var(--desk-ink); font: 600 1.65rem/1.05 'Barlow Condensed', sans-serif; }\n.fd-case-empty p { max-width: 420px; margin: 0; color: var(--desk-muted); font-size: .7rem; line-height: 1.75; }\n.fd-empty-rule { width: 56px; height: 2px; margin: 17px 0 12px; background: var(--desk-brass); }\n.fd-case-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: auto; padding: 12px 20px; border-top: 1px solid rgba(205,173,112,.13); color: var(--desk-muted); font: 400 .52rem 'DM Mono', monospace; letter-spacing: .05em; }\n.fd-case-foot span:last-child { color: var(--desk-olive); }\n.fd-context { display: flex; flex-direction: column; border: 1px solid var(--desk-line); background: rgba(32,39,34,.7); }\n.fd-context-block { padding: 17px 19px; }\n.fd-context-block + .fd-context-block { border-top: 1px solid var(--desk-line); }\n.fd-context-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 13px; }\n.fd-context-heading .fd-kicker { margin: 0; font-size: .53rem; }\n.fd-context-time { color: var(--desk-muted); font: 400 .52rem 'DM Mono', monospace; }\n.fd-clock { margin: 0; color: var(--desk-ink); font: 500 2.25rem/.95 'Barlow Condensed', sans-serif; letter-spacing: .045em; font-variant-numeric: tabular-nums; }\n.fd-date { margin: 6px 0 0; color: var(--desk-muted); font-size: .67rem; }\n.fd-zone { margin: 4px 0 0; color: var(--desk-brass); font: 400 .51rem 'DM Mono', monospace; }\n.fd-event-empty { display: flex; align-items: start; gap: 12px; padding: 12px 12px 11px; border-left: 1px solid var(--desk-brass); background: rgba(213,173,111,.045); }\n.fd-event-date { display: grid; flex: 0 0 38px; place-items: center; height: 38px; border: 1px solid rgba(213,173,111,.27); color: var(--desk-brass); font: 400 .49rem 'DM Mono', monospace; text-align: center; }\n.fd-event-empty b { display: block; margin: 1px 0 4px; color: var(--desk-ink); font-size: .67rem; }\n.fd-event-empty p { margin: 0; color: var(--desk-muted); font-size: .58rem; line-height: 1.6; }\n.fd-text-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 11px; color: var(--desk-brass); font-size: .59rem; font-weight: 700; text-decoration: none; }\n.fd-lower-grid { display: grid; grid-template-columns: minmax(0, 1.28fr) minmax(300px, .72fr); gap: 19px; margin-top: 19px; }\n.fd-connection { border: 1px solid var(--desk-line); background: rgba(32,39,34,.64); }\n.fd-connection details > summary { display: flex; align-items: center; justify-content: space-between; gap: 15px; min-height: 74px; padding: 15px 18px; color: var(--desk-ink); list-style: none; cursor: pointer; }\n.fd-connection details > summary::-webkit-details-marker { display: none; }\n.fd-summary-title { display: flex; flex-direction: column; gap: 5px; }\n.fd-summary-title b { font: 600 1.12rem 'Barlow Condensed', sans-serif; letter-spacing: .015em; }\n.fd-summary-title small { color: var(--desk-muted); font-size: .57rem; line-height: 1.5; }\n.fd-check-status { display: flex; align-items: center; gap: 8px; color: var(--desk-muted); font: 400 .53rem 'DM Mono', monospace; text-transform: uppercase; white-space: nowrap; }\n.fd-check-status::before { content: ''; width: 6px; height: 6px; border: 1px solid var(--desk-muted); border-radius: 50%; }\n.fd-disclosure-arrow { color: var(--desk-brass); font: 500 1.1rem 'DM Mono', monospace; transition: transform .18s ease; }\n.fd-connection details[open] .fd-disclosure-arrow { transform: rotate(45deg); }\n.fd-connection-body { padding: 0 18px 17px; border-top: 1px solid rgba(205,173,112,.12); }\n.fd-connection-intro { max-width: 640px; margin: 14px 0 13px; color: var(--desk-muted); font-size: .62rem; line-height: 1.65; }\n.fd-data-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid rgba(205,173,112,.16); }\n.fd-data-cell { min-height: 66px; padding: 11px 12px; }\n.fd-data-cell + .fd-data-cell { border-left: 1px solid rgba(205,173,112,.14); }\n.fd-data-cell small { display: block; margin-bottom: 8px; color: var(--desk-muted); font: 400 .48rem 'DM Mono', monospace; letter-spacing: .05em; text-transform: uppercase; }\n.fd-data-cell b { color: var(--desk-ink); font-size: .64rem; font-weight: 600; }\n.fd-connection-actions { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 13px; }\n.fd-button { min-height: 36px; padding: 0 13px; border: 1px solid var(--desk-brass); border-radius: 2px; color: #171914; background: var(--desk-brass); font-size: .61rem; font-weight: 800; cursor: pointer; }\n.fd-button:hover { color: var(--desk-brass); background: transparent; }\n.fd-fineprint { max-width: 420px; margin: 0; color: var(--desk-muted); font-size: .54rem; line-height: 1.65; }\n.fd-feedback { margin: 11px 0 0; color: var(--desk-brass); font-size: .57rem; line-height: 1.55; }\n.fd-extras { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--desk-line); background: rgba(32,39,34,.64); }\n.fd-extra { display: flex; flex-direction: column; min-height: 132px; padding: 16px 17px; }\n.fd-extra + .fd-extra { border-left: 1px solid var(--desk-line); }\n.fd-extra .fd-kicker { margin-bottom: 9px; font-size: .49rem; }\n.fd-extra h3 { margin: 0; color: var(--desk-ink); font: 600 1.04rem 'Barlow Condensed', sans-serif; }\n.fd-extra p { margin: 7px 0 0; color: var(--desk-muted); font-size: .56rem; line-height: 1.6; }\n.fd-extra a { display: inline-flex; align-items: center; gap: 7px; margin-top: auto; padding-top: 12px; color: var(--desk-brass); font-size: .56rem; font-weight: 700; text-decoration: none; }\n.fd-extra .fd-limit { color: var(--desk-olive); font: 400 .47rem 'DM Mono', monospace; letter-spacing: .03em; }\n.fd-map-section { margin-top: 24px; border: 1px solid rgba(205,173,112,.4); background: rgba(32,39,34,.74); }\n.fd-map-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 17px 19px; }\n.fd-map-head-copy { display: flex; align-items: center; gap: 17px; min-width: 0; }\n.fd-map-index { color: rgba(213,173,111,.56); font: 400 .65rem 'DM Mono', monospace; }\n.fd-map-head h2 { margin: 0; color: var(--desk-ink); font: 600 1.35rem 'Barlow Condensed', sans-serif; }\n.fd-map-head p { margin: 3px 0 0; color: var(--desk-muted); font-size: .57rem; }\n.fd-map-disclosure { display: block; }\n.fd-map-disclosure > summary { display: flex; align-items: center; justify-content: space-between; gap: 17px; padding: 17px 19px; list-style: none; cursor: pointer; }\n.fd-map-disclosure > summary::-webkit-details-marker { display: none; }\n.fd-map-summary-main { display: flex; align-items: center; gap: 17px; min-width: 0; }\n.fd-map-summary-copy h2 { margin: 0; color: var(--desk-ink); font: 600 1.38rem 'Barlow Condensed', sans-serif; }\n.fd-map-summary-copy p { margin: 3px 0 0; color: var(--desk-muted); font-size: .58rem; }\n.fd-map-summary-meta { color: var(--desk-muted); font: 400 .49rem 'DM Mono', monospace; letter-spacing: .07em; text-transform: uppercase; white-space: nowrap; }\n.fd-map-show { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 136px; min-height: 39px; padding: 0 13px; border: 1px solid var(--desk-brass); color: var(--desk-brass); font-size: .6rem; font-weight: 800; white-space: nowrap; }\n.fd-map-show b { font: 500 1rem 'DM Mono', monospace; }\n.fd-map-disclosure[open] .fd-map-show .fd-open-label { display: none; }\n.fd-map-disclosure:not([open]) .fd-map-show .fd-close-label { display: none; }\n.fd-map-disclosure[open] .fd-map-summary-meta { color: var(--desk-olive); }\n.fd-map-body { padding: 0 18px 17px; }\n.fd-map-viewport { position: relative; display: grid; place-items: center; min-height: 258px; padding: 28px; overflow: hidden; border: 1px solid rgba(205,173,112,.2); background: linear-gradient(145deg, rgba(16,22,18,.95), rgba(24,31,26,.95)); text-align: center; }\n.fd-map-viewport::before, .fd-map-viewport::after { position: absolute; content: ''; pointer-events: none; }\n.fd-map-viewport::before { inset: 0; opacity: .5; background: linear-gradient(rgba(205,173,112,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(205,173,112,.045) 1px, transparent 1px); background-size: 34px 34px; }\n.fd-map-viewport::after { top: 50%; left: 50%; width: 1px; height: 50%; background: linear-gradient(transparent, rgba(205,173,112,.18), transparent); transform: translate(-50%,-50%); }\n.fd-map-empty { position: relative; z-index: 1; max-width: 470px; }\n.fd-map-empty .fd-map-overline { margin: 0 0 10px; color: var(--desk-brass); font: 400 .5rem 'DM Mono', monospace; letter-spacing: .09em; text-transform: uppercase; }\n.fd-map-empty h3 { margin: 0; color: var(--desk-ink); font: 600 1.5rem 'Barlow Condensed', sans-serif; }\n.fd-map-empty p { margin: 7px 0 0; color: var(--desk-muted); font-size: .62rem; line-height: 1.65; }\n.fd-map-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding-top: 13px; }\n.fd-map-tools label { display: flex; align-items: start; gap: 9px; color: var(--desk-muted); font-size: .55rem; line-height: 1.5; }\n.fd-map-tools input { flex: 0 0 auto; width: 14px; height: 14px; margin: 1px 0 0; accent-color: var(--desk-brass); }\n.fd-map-tools input:disabled { opacity: .55; }\n.fd-map-actions { display: flex; align-items: center; gap: 13px; }\n.fd-map-expand { min-height: 32px; padding: 0 10px; border: 1px solid var(--desk-line); color: var(--desk-ink); background: transparent; font-size: .55rem; font-weight: 700; cursor: pointer; }\n.fd-map-expand:hover { border-color: var(--desk-brass); color: var(--desk-brass); }\n.fd-map-actions small { max-width: 250px; color: var(--desk-muted); font-size: .49rem; line-height: 1.55; }\n.fd-map-disclosure.map-open .fd-map-viewport { min-height: 340px; }\n.fd-map-disclosure.map-expanded .fd-map-viewport { min-height: 510px; }\n.fd-footer { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--desk-line); color: var(--desk-muted); font: 400 .48rem 'DM Mono', monospace; letter-spacing: .035em; }\n.fd-footer strong { color: var(--desk-brass); font-weight: 500; }\n@media (max-width: 1000px) {\n .fd-wrap { width: min(100% - 40px, 900px); }\n .fd-topbar { flex-wrap: wrap; padding: 14px 0; }\n .fd-account { margin-left: auto; }\n .fd-nav { order: 3; width: 100%; overflow-x: auto; }\n .fd-nav a { flex: 0 0 auto; }\n .fd-main-grid { grid-template-columns: minmax(0, 1.35fr) minmax(270px, .8fr); }\n .fd-lower-grid { grid-template-columns: 1fr; }\n}\n@media (max-width: 700px) {\n .fd-wrap { width: calc(100% - 30px); }\n .fd-topbar { gap: 13px; min-height: 0; }\n .fd-brand b { font-size: 1.45rem; }\n .fd-brand span { font-size: .48rem; }\n .fd-verified { display: none; }\n .fd-nav { gap: 1px; }\n .fd-nav a { padding: 9px 10px; font-size: .61rem; }\n .fd-page { padding-top: 32px; padding-bottom: 35px; }\n .fd-pagehead { align-items: start; flex-direction: column; gap: 17px; margin-bottom: 20px; }\n .fd-pagehead h1 { font-size: 3.1rem; }\n .fd-pagehead-copy { max-width: 490px; }\n .fd-member-id { display: none; }\n .fd-main-grid { grid-template-columns: 1fr; }\n .fd-case-panel { min-height: 286px; }\n .fd-case-empty { grid-template-columns: 68px 1fr; gap: 18px; padding: 25px 19px; }\n .fd-empty-mark { width: 60px; height: 60px; font-size: .48rem; }\n .fd-empty-mark::before { height: 78px; }\n .fd-empty-mark::after { width: 78px; }\n .fd-case-empty h3 { font-size: 1.45rem; }\n .fd-context-block { padding: 16px; }\n .fd-lower-grid { gap: 12px; margin-top: 12px; }\n .fd-data-grid { grid-template-columns: 1fr; }\n .fd-data-cell { min-height: 0; padding: 9px 11px; }\n .fd-data-cell + .fd-data-cell { border-top: 1px solid rgba(205,173,112,.14); border-left: 0; }\n .fd-connection-actions { align-items: start; flex-direction: column; }\n .fd-extras { grid-template-columns: 1fr; }\n .fd-extra { min-height: 117px; }\n .fd-extra + .fd-extra { border-top: 1px solid var(--desk-line); border-left: 0; }\n .fd-map-section { margin-top: 18px; }\n .fd-map-disclosure > summary { align-items: start; flex-direction: column; }\n .fd-map-summary-main { align-items: start; }\n .fd-map-show { width: 100%; }\n .fd-map-summary-meta { display: none; }\n .fd-map-viewport { min-height: 240px; padding: 22px 17px; }\n .fd-map-tools { align-items: start; flex-direction: column; }\n .fd-map-actions { align-items: start; flex-direction: column; }\n .fd-footer { align-items: start; flex-direction: column; gap: 7px; }\n}\n</style>\n<div class=\"field-desk\" data-kid=\"1\">\n    <header aria-label=\"ARRAI Detective Agency member navigation\" class=\"fd-wrap fd-topbar\" data-kid=\"1-1\">\n        <a aria-label=\"ARRAI Field Office dashboard\" class=\"fd-brand\" data-kid=\"1-1-1\" href=\"#desk\">\n            <b data-kid=\"1-1-1-1\">\n                ARRAI\n            </b>\n            <span data-kid=\"1-1-1-2\">\n                FIELD OFFICE\n            </span>\n        </a>\n        <nav aria-label=\"Member workspace\" class=\"fd-nav\" data-kid=\"1-1-2\">\n            <a aria-current=\"page\" data-kid=\"1-1-2-1\" href=\"#desk\">\n                Field desk\n            </a>\n            <a data-kid=\"1-1-2-2\" href=\"#assigned\">\n                Assigned cases\n            </a>\n            <a data-kid=\"1-1-2-3\" href=\"#public-calendar\">\n                Public calendar\n            </a>\n            <a data-kid=\"1-1-2-4\" href=\"#earth-map\">\n                Explore Earth\n            </a>\n        </nav>\n        <div class=\"fd-account\" data-kid=\"1-1-3\">\n            <span class=\"fd-verified\" data-kid=\"1-1-3-1\">\n                <i data-kid=\"1-1-3-1-1\">\n                </i>\n                VERIFIED MEMBER\n            </span>\n            <button class=\"fd-logout\" data-kid=\"1-1-3-2\" type=\"button\">\n                Log out\n            </button>\n        </div>\n    </header>\n    <main class=\"fd-wrap fd-page\" data-kid=\"1-2\" id=\"desk\">\n        <section aria-labelledby=\"desk-title\" class=\"fd-pagehead\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <p class=\"fd-kicker\" data-kid=\"1-2-1-1-1\">\n                    Private member area · assigned work only\n                </p>\n                <h1 data-kid=\"1-2-1-1-2\" id=\"desk-title\">\n                    Field\n                    <em data-kid=\"1-2-1-1-2-1\">\n                        desk\n                    </em>\n                </h1>\n                <p class=\"fd-pagehead-copy\" data-kid=\"1-2-1-1-3\">\n                    A private workspace for your verified account. Only cases assigned to you appear here.\n                </p>\n            </div>\n            <div aria-label=\"Member access status\" class=\"fd-member-id\" data-kid=\"1-2-1-2\">\n                <small data-kid=\"1-2-1-2-1\">\n                    Access status\n                </small>\n                <b data-kid=\"1-2-1-2-2\">\n                    Approved member\n                </b>\n            </div>\n        </section>\n        <div class=\"fd-main-grid\" data-kid=\"1-2-2\">\n            <section aria-labelledby=\"assigned-title\" class=\"fd-case-panel\" data-kid=\"1-2-2-1\" id=\"assigned\">\n                <div class=\"fd-panel-heading\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <p class=\"fd-kicker\" data-kid=\"1-2-2-1-1-1-1\">\n                            Private work register\n                        </p>\n                        <h2 data-kid=\"1-2-2-1-1-1-2\" id=\"assigned-title\">\n                            Assigned cases\n                        </h2>\n                    </div>\n                    <span class=\"fd-label-tag\" data-kid=\"1-2-2-1-1-2\">\n                        This account only\n                    </span>\n                </div>\n                <div class=\"fd-case-empty\" data-kid=\"1-2-2-1-2\">\n                    <div aria-hidden=\"true\" class=\"fd-empty-mark\" data-kid=\"1-2-2-1-2-1\">\n                        NO FILES\n                    </div>\n                    <div data-kid=\"1-2-2-1-2-2\">\n                        <p class=\"fd-kicker\" data-kid=\"1-2-2-1-2-2-1\">\n                            Assignment register\n                        </p>\n                        <h3 data-kid=\"1-2-2-1-2-2-2\">\n                            No cases are assigned to your account yet.\n                        </h3>\n                        <div class=\"fd-empty-rule\" data-kid=\"1-2-2-1-2-2-3\">\n                        </div>\n                        <p data-kid=\"1-2-2-1-2-2-4\">\n                            When a case is assigned to your verified account, its approved summary and current status will appear here. This workspace does not show other members’ cases.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"fd-case-foot\" data-kid=\"1-2-2-1-3\">\n                    <span data-kid=\"1-2-2-1-3-1\">\n                        PRIVATE REGISTER · MEMBER ACCESS REQUIRED\n                    </span>\n                    <span data-kid=\"1-2-2-1-3-2\">\n                        NO ASSIGNMENTS\n                    </span>\n                </div>\n            </section>\n            <aside aria-label=\"Local time and public calendar\" class=\"fd-context\" data-kid=\"1-2-2-2\">\n                <section aria-labelledby=\"today-title\" class=\"fd-context-block\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"fd-context-heading\" data-kid=\"1-2-2-2-1-1\">\n                        <p class=\"fd-kicker\" data-kid=\"1-2-2-2-1-1-1\" id=\"today-title\">\n                            Today · your local time\n                        </p>\n                        <span class=\"fd-context-time\" data-kid=\"1-2-2-2-1-1-2\">\n                            LIVE CLOCK\n                        </span>\n                    </div>\n                    <p aria-live=\"off\" class=\"fd-clock\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2\" data-name=\"live clock time display\" data-reason=\"text updated every second by script\" id=\"fdClock\">\n                        --:--:--\n                    </p>\n                    <p class=\"fd-date\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-3\" data-name=\"local date display\" data-reason=\"text updated every second by script\" id=\"fdDate\">\n                        Loading local date…\n                    </p>\n                    <p class=\"fd-zone\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-4\" data-name=\"time zone display\" data-reason=\"text updated every second by script\" id=\"fdZone\">\n                        Resolving browser time zone…\n                    </p>\n                </section>\n                <section aria-labelledby=\"public-calendar-title\" class=\"fd-context-block\" data-kid=\"1-2-2-2-2\" id=\"public-calendar\">\n                    <div class=\"fd-context-heading\" data-kid=\"1-2-2-2-2-1\">\n                        <p class=\"fd-kicker\" data-kid=\"1-2-2-2-2-1-1\" id=\"public-calendar-title\">\n                            Public calendar\n                        </p>\n                        <span class=\"fd-context-time\" data-kid=\"1-2-2-2-2-1-2\">\n                            UPCOMING EVENTS\n                        </span>\n                    </div>\n                    <div class=\"fd-event-empty\" data-kid=\"1-2-2-2-2-2\">\n                        <div aria-hidden=\"true\" class=\"fd-event-date\" data-kid=\"1-2-2-2-2-2-1\">\n                            AR\n                            <br data-kid=\"1-2-2-2-2-2-1-1\"/>\n                            EVENTS\n                        </div>\n                        <div data-kid=\"1-2-2-2-2-2-2\">\n                            <b data-kid=\"1-2-2-2-2-2-2-1\">\n                                No upcoming public events\n                            </b>\n                            <p data-kid=\"1-2-2-2-2-2-2-2\">\n                                This is the public AR calendar, not a private appointment list.\n                            </p>\n                        </div>\n                    </div>\n                    <a class=\"fd-text-link\" data-kid=\"1-2-2-2-2-3\" href=\"https://arrai.in/calendar.html\">\n                        Open public calendar\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-2-2-3-1\">\n                            ↗\n                        </span>\n                    </a>\n                </section>\n            </aside>\n        </div>\n        <div class=\"fd-lower-grid\" data-kid=\"1-2-3\">\n            <section aria-labelledby=\"connection-title\" class=\"fd-connection\" data-kid=\"1-2-3-1\">\n                <details data-kid=\"1-2-3-1-1\">\n                    <summary data-kid=\"1-2-3-1-1-1\" id=\"connection-title\">\n                        <span class=\"fd-summary-title\" data-kid=\"1-2-3-1-1-1-1\">\n                            <b data-kid=\"1-2-3-1-1-1-1-1\">\n                                My current connection\n                            </b>\n                            <small data-kid=\"1-2-3-1-1-1-1-2\">\n                                Optional check · information describes this connection only\n                            </small>\n                        </span>\n                        <span class=\"fd-check-status\" data-dynamic=\"true\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"connection status indicator\" data-reason=\"text replaced by script on connection check\" id=\"connectionStatus\">\n                            Not checked\n                        </span>\n                        <span aria-hidden=\"true\" class=\"fd-disclosure-arrow\" data-kid=\"1-2-3-1-1-1-3\">\n                            +\n                        </span>\n                    </summary>\n                    <div class=\"fd-connection-body\" data-kid=\"1-2-3-1-1-2\">\n                        <p class=\"fd-connection-intro\" data-kid=\"1-2-3-1-1-2-1\">\n                            Check only your current network connection. IP-based region and ISP information can be approximate; a VPN/proxy result is an estimate, not proof of a person’s identity or location.\n                        </p>\n                        <div aria-label=\"Connection lookup results\" class=\"fd-data-grid\" data-kid=\"1-2-3-1-1-2-2\">\n                            <div class=\"fd-data-cell\" data-kid=\"1-2-3-1-1-2-2-1\">\n                                <small data-kid=\"1-2-3-1-1-2-2-1-1\">\n                                    Public IP\n                                </small>\n                                <b data-dynamic=\"true\" data-kid=\"1-2-3-1-1-2-2-1-2\" data-name=\"public IP result\" data-reason=\"text replaced by script on connection check\" id=\"ipResult\">\n                                    Not checked\n                                </b>\n                            </div>\n                            <div class=\"fd-data-cell\" data-kid=\"1-2-3-1-1-2-2-2\">\n                                <small data-kid=\"1-2-3-1-1-2-2-2-1\">\n                                    Approx. region · ISP\n                                </small>\n                                <b data-dynamic=\"true\" data-kid=\"1-2-3-1-1-2-2-2-2\" data-name=\"region ISP result\" data-reason=\"text replaced by script on connection check\" id=\"regionResult\">\n                                    Not checked\n                                </b>\n                            </div>\n                            <div class=\"fd-data-cell\" data-kid=\"1-2-3-1-1-2-2-3\">\n                                <small data-kid=\"1-2-3-1-1-2-2-3-1\">\n                                    VPN / proxy estimate\n                                </small>\n                                <b data-dynamic=\"true\" data-kid=\"1-2-3-1-1-2-2-3-2\" data-name=\"VPN proxy estimate result\" data-reason=\"text replaced by script on connection check\" id=\"vpnResult\">\n                                    Not checked\n                                </b>\n                            </div>\n                        </div>\n                        <div class=\"fd-connection-actions\" data-kid=\"1-2-3-1-1-2-3\">\n                            <button class=\"fd-button\" data-kid=\"1-2-3-1-1-2-3-1\" id=\"connectionCheck\" type=\"button\">\n                                Check my connection\n                            </button>\n                            <p class=\"fd-fineprint\" data-kid=\"1-2-3-1-1-2-3-2\">\n                                This describes your connection, not another person. It cannot identify someone or establish their exact location.\n                            </p>\n                        </div>\n                        <p class=\"fd-feedback\" data-dynamic=\"true\" data-kid=\"1-2-3-1-1-2-4\" data-name=\"connection status feedback message\" data-reason=\"text replaced and visibility toggled by script on check\" hidden=\"\" id=\"connectionFeedback\" role=\"status\">\n                        </p>\n                    </div>\n                </details>\n            </section>\n            <section aria-label=\"Help and educational science\" class=\"fd-extras\" data-kid=\"1-2-3-2\">\n                <article class=\"fd-extra\" data-kid=\"1-2-3-2-1\">\n                    <p class=\"fd-kicker\" data-kid=\"1-2-3-2-1-1\">\n                        Site guide\n                    </p>\n                    <h3 data-kid=\"1-2-3-2-1-2\">\n                        Ask AR for help\n                    </h3>\n                    <p data-kid=\"1-2-3-2-1-3\">\n                        Get help with public pages, navigation, and this workspace’s controls.\n                    </p>\n                    <a data-kid=\"1-2-3-2-1-4\" href=\"https://arrai.in/\">\n                        Open AR assistant\n                        <span aria-hidden=\"true\" data-kid=\"1-2-3-2-1-4-1\">\n                            ↗\n                        </span>\n                    </a>\n                    <small class=\"fd-limit\" data-kid=\"1-2-3-2-1-5\">\n                        AR cannot inspect assigned cases.\n                    </small>\n                </article>\n                <article class=\"fd-extra\" data-kid=\"1-2-3-2-2\">\n                    <p class=\"fd-kicker\" data-kid=\"1-2-3-2-2-1\">\n                        Optional · educational\n                    </p>\n                    <h3 data-kid=\"1-2-3-2-2-2\">\n                        Solar system & space science\n                    </h3>\n                    <p data-kid=\"1-2-3-2-2-3\">\n                        A separate learning view; no claim of complete or live universe data.\n                    </p>\n                    <a data-kid=\"1-2-3-2-2-4\" href=\"https://science.nasa.gov/solar-system/\" rel=\"noreferrer\" target=\"_blank\">\n                        NASA Solar System Exploration\n                        <span aria-hidden=\"true\" data-kid=\"1-2-3-2-2-4-1\">\n                            ↗\n                        </span>\n                    </a>\n                    <small class=\"fd-limit\" data-kid=\"1-2-3-2-2-5\">\n                        Educational reference · not live telemetry.\n                    </small>\n                </article>\n            </section>\n        </div>\n        <section aria-labelledby=\"earth-map-title\" class=\"fd-map-section\" data-kid=\"1-2-4\" id=\"earth-map\">\n            <details class=\"fd-map-disclosure\" data-kid=\"1-2-4-1\" id=\"mapDisclosure\">\n                <summary data-kid=\"1-2-4-1-1\">\n                    <span class=\"fd-map-summary-main\" data-kid=\"1-2-4-1-1-1\">\n                        <span class=\"fd-map-index\" data-kid=\"1-2-4-1-1-1-1\">\n                            01 /\n                        </span>\n                        <span class=\"fd-map-summary-copy\" data-kid=\"1-2-4-1-1-1-2\">\n                            <h2 data-kid=\"1-2-4-1-1-1-2-1\" id=\"earth-map-title\">\n                                Explore Earth\n                            </h2>\n                            <p data-kid=\"1-2-4-1-1-1-2-2\">\n                                Global map view · separate from private case records\n                            </p>\n                        </span>\n                    </span>\n                    <span class=\"fd-map-show\" data-kid=\"1-2-4-1-1-2\">\n                        <span class=\"fd-open-label\" data-kid=\"1-2-4-1-1-2-1\">\n                            Show map\n                        </span>\n                        <span class=\"fd-close-label\" data-kid=\"1-2-4-1-1-2-2\">\n                            Hide map\n                        </span>\n                        <b aria-hidden=\"true\" data-kid=\"1-2-4-1-1-2-3\">\n                            ↗\n                        </b>\n                    </span>\n                    <span class=\"fd-map-summary-meta\" data-dynamic=\"true\" data-kid=\"1-2-4-1-1-3\" data-name=\"map disclosure status\" data-reason=\"text replaced by script on toggle\" id=\"mapStatus\">\n                        Map closed\n                    </span>\n                </summary>\n                <div class=\"fd-map-body\" data-kid=\"1-2-4-1-2\">\n                    <div aria-label=\"Earth map preview unavailable\" class=\"fd-map-viewport\" data-kid=\"1-2-4-1-2-1\" id=\"mapViewport\" role=\"region\">\n                        <div class=\"fd-map-empty\" data-kid=\"1-2-4-1-2-1-1\">\n                            <p class=\"fd-map-overline\" data-kid=\"1-2-4-1-2-1-1-1\">\n                                Earth · global view\n                            </p>\n                            <h3 data-kid=\"1-2-4-1-2-1-1-2\">\n                                Map provider not connected\n                            </h3>\n                            <p data-kid=\"1-2-4-1-2-1-1-3\">\n                                A live map is not loaded in this concept, so no map imagery, borders, or location markers are shown.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"fd-map-tools\" data-kid=\"1-2-4-1-2-2\">\n                        <label data-kid=\"1-2-4-1-2-2-1\">\n                            <input data-kid=\"1-2-4-1-2-2-1-1\" disabled=\"\" id=\"regionToggle\" type=\"checkbox\"/>\n                            <span data-kid=\"1-2-4-1-2-2-1-2\">\n                                Show my approximate connection region on the map\n                                <br data-kid=\"1-2-4-1-2-2-1-2-1\"/>\n                                <small data-kid=\"1-2-4-1-2-2-1-2-2\">\n                                    Optional and off by default · available only after an authorized lookup returns region data.\n                                </small>\n                            </span>\n                        </label>\n                        <div class=\"fd-map-actions\" data-kid=\"1-2-4-1-2-2-2\">\n                            <button class=\"fd-map-expand\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"expand map button\" data-reason=\"text toggled by script between Expand and Restore labels\" id=\"expandMap\" type=\"button\">\n                                Expand map\n                            </button>\n                            <small data-kid=\"1-2-4-1-2-2-2-2\">\n                                F11 toggles browser full-screen; it does not expand only the map.\n                            </small>\n                        </div>\n                    </div>\n                </div>\n            </details>\n        </section>\n        <footer class=\"fd-footer\" data-kid=\"1-2-5\">\n            <span data-kid=\"1-2-5-1\">\n                <strong data-kid=\"1-2-5-1-1\">\n                    ARRAI FIELD OFFICE\n                </strong>\n                · verified member workspace\n            </span>\n            <span data-kid=\"1-2-5-2\">\n                Only your assigned cases are private to this account.\n            </span>\n            <span data-kid=\"1-2-5-3\">\n                Connection details are opt-in and approximate.\n            </span>\n        </footer>\n    </main>\n</div>\n<script>\n    (() => {\n  const clock = document.getElementById('fdClock');\n  const date = document.getElementById('fdDate');\n  const zone = document.getElementById('fdZone');\n  const updateClock = () => {\n    const now = new Date();\n    clock.textContent = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(now);\n    date.textContent = new Intl.DateTimeFormat(undefined, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(now);\n    zone.textContent = `${Intl.DateTimeFormat().resolvedOptions().timeZone || 'Local time zone'} · ${new Intl.DateTimeFormat(undefined, { timeZoneName: 'short' }).formatToParts(now).find(part => part.type === 'timeZoneName')?.value || 'local'}`;\n  };\n  updateClock();\n  setInterval(updateClock, 1000);\n\n  const map = document.getElementById('mapDisclosure');\n  const mapStatus = document.getElementById('mapStatus');\n  map.addEventListener('toggle', () => {\n    map.classList.toggle('map-open', map.open);\n    mapStatus.textContent = map.open ? 'Map source unavailable' : 'Map closed';\n    const button = document.getElementById('expandMap');\n    button.textContent = map.classList.contains('map-expanded') ? 'Restore map panel' : 'Expand map';\n  });\n  document.getElementById('expandMap').addEventListener('click', event => {\n    event.stopPropagation();\n    map.classList.toggle('map-expanded');\n    event.currentTarget.textContent = map.classList.contains('map-expanded') ? 'Restore map panel' : 'Expand map';\n  });\n  document.getElementById('connectionCheck').addEventListener('click', () => {\n    const feedback = document.getElementById('connectionFeedback');\n    feedback.hidden = false;\n    feedback.textContent = 'A connection lookup source is not configured in this preview. No IP or location data was retrieved.';\n  });\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-28T16:13:36.361876+00:00",
      "modified": "2026-09-28T16:14:39.358468+00:00",
      "id": "var_714c41a5e353"
    },
    "var_23e20523d157": {
      "type": "variant",
      "label": "02 · Daily Briefing",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css\");\n:root{--field-paper:#151a17;--field-panel:#202722;--field-ink:#eee9dc;--field-muted:#a6aaa1;--field-brass:#d5ad6f;--field-line:rgba(205,173,112,.24);--field-coral:#d77a59;--field-sage:#a9b991;--field-deep:#101410;}\nbody{margin:0;background:var(--field-paper);color:var(--field-ink);font-family:Manrope,Arial,sans-serif;}\n.field-page{min-height:100vh;background-color:var(--field-paper);background-image:linear-gradient(rgba(205,173,112,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(205,173,112,.035) 1px,transparent 1px);background-size:44px 44px;}\n.field-wrap{width:min(1320px,calc(100% - 64px));margin:0 auto;}\n.field-header{height:78px;display:flex;align-items:center;justify-content:space-between;gap:26px;border-bottom:1px solid var(--field-line);}\n.field-brand{display:flex;align-items:center;gap:12px;flex:0 0 auto;color:var(--field-ink);text-decoration:none;}\n.brand-mark{display:grid;place-items:center;width:37px;height:37px;border:1px solid rgba(213,173,111,.55);color:var(--field-brass);font-size:19px;}\n.brand-title{font:700 1.45rem/1 'Barlow Condensed',sans-serif;letter-spacing:.09em;}\n.brand-sub{display:block;margin-top:3px;color:var(--field-brass);font:500 .53rem/1 'DM Mono',monospace;letter-spacing:.16em;}\n.header-nav{display:flex;align-items:center;gap:8px;margin-left:auto;}\n.header-nav a{padding:9px 12px;color:var(--field-muted);font:500 .69rem 'DM Mono',monospace;letter-spacing:.03em;text-decoration:none;border:1px solid transparent;}\n.header-nav a.active{border-color:var(--field-line);color:var(--field-brass);background:rgba(213,173,111,.07);}\n.session-tools{display:flex;align-items:center;gap:12px;flex:0 0 auto;}\n.session-status{display:inline-flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--field-line);color:var(--field-muted);font:500 .57rem 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;}\n.session-status i{color:var(--field-sage);font-size:14px;}\n.signout{border:0;border-left:1px solid var(--field-line);padding:9px 0 9px 13px;background:none;color:var(--field-muted);font:600 .63rem 'DM Mono',monospace;cursor:pointer;}\n.briefing-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(350px,455px);gap:44px;align-items:end;padding:50px 0 34px;border-bottom:1px solid var(--field-line);}\n.kicker{display:flex;align-items:center;gap:10px;margin:0 0 16px;color:var(--field-brass);font:500 .64rem 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;}\n.kicker::before{content:'';width:7px;height:7px;border:1px solid var(--field-brass);border-radius:50%;box-shadow:0 0 0 4px rgba(213,173,111,.09);}\n.briefing-head h1{margin:0;font:600 clamp(2.8rem,5vw,4.55rem)/.94 'Barlow Condensed',sans-serif;letter-spacing:.005em;}\n.briefing-head h1 em{color:var(--field-brass);font:600 italic .76em 'Playfair Display',serif;}\n.briefing-intro{max-width:630px;margin:17px 0 0;color:var(--field-muted);font-size:.77rem;line-height:1.75;}\n.clock-panel{display:grid;grid-template-columns:1fr auto;gap:7px 14px;align-items:end;padding:17px 20px 16px;border:1px solid var(--field-line);border-top:2px solid var(--field-brass);background:rgba(32,39,34,.8);}\n.clock-label{grid-column:1/-1;color:var(--field-brass);font:500 .57rem 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase;}\n.clock-time{color:var(--field-ink);font:600 clamp(2.9rem,4vw,4rem)/.92 'Barlow Condensed',sans-serif;font-variant-numeric:tabular-nums;letter-spacing:.025em;}\n.clock-zone{align-self:end;padding-bottom:4px;color:var(--field-muted);font:500 .62rem/1.6 'DM Mono',monospace;text-align:right;}\n.clock-date{grid-column:1/-1;padding-top:11px;border-top:1px solid var(--field-line);color:var(--field-ink);font-size:.75rem;font-weight:600;}\n.clock-note{grid-column:1/-1;margin-top:-3px;color:var(--field-muted);font:400 .57rem 'DM Mono',monospace;}\n.scope-rail{display:flex;align-items:center;gap:0;margin:20px 0 37px;padding:0;border-bottom:1px solid var(--field-line);}\n.scope-rail a{display:flex;align-items:center;gap:9px;padding:12px 22px 12px 0;margin-right:24px;color:var(--field-muted);font:500 .59rem 'DM Mono',monospace;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;}\n.scope-rail a span{color:var(--field-brass);}\n.scope-rail .scope-note{margin-left:auto;padding:12px 0;color:#7f887e;font:400 .56rem 'DM Mono',monospace;}\n.section-block{margin:0 0 38px;}\n.section-heading{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:15px;}\n.section-id{display:flex;align-items:center;gap:11px;margin:0 0 7px;color:var(--field-brass);font:500 .57rem 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase;}\n.section-id span{color:var(--field-muted);}\n.section-heading h2{margin:0;font:600 1.95rem/1 'Barlow Condensed',sans-serif;letter-spacing:.01em;}\n.section-source{display:inline-flex;align-items:center;gap:8px;color:var(--field-muted);font:400 .57rem 'DM Mono',monospace;letter-spacing:.05em;text-transform:uppercase;}\n.section-source i{color:var(--field-brass);font-size:13px;}\n.work-panel{display:grid;grid-template-columns:minmax(0,1fr) 260px;min-height:190px;border:1px solid var(--field-line);background:linear-gradient(105deg,rgba(32,39,34,.96),rgba(25,31,27,.87));}\n.work-empty{display:flex;align-items:center;gap:19px;padding:25px 29px;}\n.empty-glyph{display:grid;place-items:center;width:47px;height:47px;flex:0 0 47px;border:1px solid rgba(213,173,111,.37);color:var(--field-brass);font-size:19px;background:rgba(213,173,111,.06);}\n.empty-copy small{display:block;margin-bottom:7px;color:var(--field-brass);font:500 .56rem 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;}\n.empty-copy h3{margin:0 0 7px;font:600 1.4rem 'Barlow Condensed',sans-serif;}\n.empty-copy p{max-width:540px;margin:0;color:var(--field-muted);font-size:.69rem;line-height:1.7;}\n.work-context{display:grid;align-content:center;gap:13px;padding:21px 23px;border-left:1px solid var(--field-line);background:rgba(16,20,16,.35);}\n.context-row{display:grid;grid-template-columns:84px 1fr;gap:8px;align-items:baseline;}\n.context-row dt{color:#7f887e;font:400 .52rem 'DM Mono',monospace;letter-spacing:.07em;text-transform:uppercase;}\n.context-row dd{margin:0;color:var(--field-ink);font-size:.61rem;line-height:1.55;}\n.secondary-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:20px;margin:0 0 39px;}\n.schedule-panel{min-height:224px;padding:21px 23px 20px;border:1px solid var(--field-line);background:rgba(32,39,34,.78);}\n.schedule-top{display:flex;align-items:start;justify-content:space-between;gap:16px;}\n.schedule-top h3,.connection-top h3{margin:0;font:600 1.42rem/1 'Barlow Condensed',sans-serif;}\n.public-chip{padding:6px 8px;border:1px solid rgba(213,173,111,.28);color:var(--field-brass);font:500 .51rem 'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;}\n.schedule-rule{display:flex;align-items:center;gap:9px;margin-top:16px;padding:10px 0;border-top:1px solid var(--field-line);border-bottom:1px solid var(--field-line);color:var(--field-muted);font:400 .54rem 'DM Mono',monospace;letter-spacing:.04em;}\n.schedule-rule i{color:var(--field-brass);font-size:13px;}\n.schedule-empty{display:flex;align-items:center;gap:12px;padding:19px 0 15px;color:var(--field-muted);}\n.schedule-empty i{font-size:18px;color:#858c80;}\n.schedule-empty p{margin:0;font-size:.69rem;line-height:1.6;}\n.schedule-link{display:inline-flex;align-items:center;gap:8px;margin-top:4px;color:var(--field-brass);font:500 .59rem 'DM Mono',monospace;text-decoration:none;}\n.connection-panel{min-height:224px;padding:21px 23px 19px;border:1px solid var(--field-line);background:rgba(24,29,25,.84);}\n.connection-top{display:flex;justify-content:space-between;align-items:start;gap:12px;}\n.connection-top .section-id{margin-bottom:7px;}\n.pending-mark{padding:6px 8px;border:1px solid rgba(166,170,161,.2);color:var(--field-muted);font:400 .5rem 'DM Mono',monospace;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap;}\n.connection-copy{max-width:410px;margin:12px 0 13px;color:var(--field-muted);font-size:.66rem;line-height:1.65;}\n.connection-action{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-top:13px;border-top:1px solid var(--field-line);}\n.connection-action p{max-width:235px;margin:0;color:#92988e;font-size:.57rem;line-height:1.55;}\n.action-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:38px;padding:0 12px;border:1px solid var(--field-brass);color:#1a1b16;background:var(--field-brass);font:700 .57rem 'DM Mono',monospace;letter-spacing:.03em;cursor:pointer;white-space:nowrap;}\n.action-button:hover{color:var(--field-brass);background:transparent;}\n.connection-disclaimer{margin:12px 0 0;padding-left:10px;border-left:2px solid rgba(213,173,111,.45);color:#93988e;font-size:.56rem;line-height:1.55;}\n.tool-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:0 0 39px;}\n.tool-panel{display:grid;grid-template-columns:46px minmax(0,1fr) auto;align-items:center;gap:15px;min-height:108px;padding:18px 21px;border:1px solid var(--field-line);background:rgba(32,39,34,.63);}\n.tool-icon{display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(213,173,111,.33);color:var(--field-brass);font-size:18px;}\n.tool-kicker{margin:0 0 4px;color:var(--field-brass);font:500 .51rem 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;}\n.tool-panel h3{margin:0;font:600 1.2rem/1.05 'Barlow Condensed',sans-serif;}\n.tool-panel p:last-child{margin:6px 0 0;color:var(--field-muted);font-size:.57rem;line-height:1.55;}\n.tool-go{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--field-line);color:var(--field-brass);font-size:16px;}\n.tool-panel.science .tool-icon{color:var(--field-sage);border-color:rgba(169,185,145,.3);}\n.tool-panel.science .tool-kicker{color:var(--field-sage);}\n.map-shelf{margin:0 0 44px;border:1px solid rgba(213,173,111,.42);background:rgba(32,39,34,.7);}\n.map-head{display:grid;grid-template-columns:54px minmax(0,1fr) auto;gap:16px;align-items:center;padding:19px 22px;}\n.map-icon{display:grid;place-items:center;width:45px;height:45px;border:1px solid rgba(213,173,111,.36);color:var(--field-brass);font-size:21px;background:rgba(213,173,111,.06);}\n.map-label{margin:0 0 5px;color:var(--field-brass);font:500 .54rem 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase;}\n.map-title{margin:0;font:600 1.55rem/1 'Barlow Condensed',sans-serif;}\n.map-description{margin:7px 0 0;color:var(--field-muted);font-size:.61rem;line-height:1.55;}\n.map-show{display:inline-flex;align-items:center;gap:9px;min-height:40px;padding:0 14px;border:1px solid var(--field-brass);color:var(--field-brass);background:transparent;font:500 .58rem 'DM Mono',monospace;cursor:pointer;white-space:nowrap;}\n.map-show:hover{color:#1a1b16;background:var(--field-brass);}\n.map-foot{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:11px 22px;border-top:1px solid var(--field-line);color:#888e83;font:400 .52rem 'DM Mono',monospace;}\n.map-panel{padding:20px 22px;border-top:1px solid var(--field-line);}\n.map-panel[hidden]{display:none;}\n.map-empty{display:flex;align-items:center;justify-content:space-between;gap:22px;min-height:140px;padding:23px;border:1px dashed rgba(213,173,111,.25);background:rgba(16,20,16,.27);}\n.map-empty h3{margin:0 0 6px;font:600 1.28rem 'Barlow Condensed',sans-serif;}\n.map-empty p{max-width:650px;margin:0;color:var(--field-muted);font-size:.63rem;line-height:1.7;}\n.map-state-actions{display:flex;flex-direction:column;align-items:flex-end;gap:9px;flex:0 0 auto;}\n.map-expand{display:inline-flex;align-items:center;gap:8px;padding:9px 11px;border:1px solid var(--field-line);color:var(--field-ink);background:transparent;font:500 .54rem 'DM Mono',monospace;cursor:pointer;}\n.map-expand-note{color:#8c9288;font:400 .49rem 'DM Mono',monospace;text-align:right;}\n.map-shelf.is-map-expanded{position:fixed;z-index:1000;inset:14px;display:flex;flex-direction:column;margin:0;overflow:auto;background:var(--field-paper);box-shadow:0 18px 80px rgba(0,0,0,.65);}\n.map-shelf.is-map-expanded .map-panel{flex:1;}\n.map-shelf.is-map-expanded .map-empty{min-height:min(70vh,720px);}\n.field-footer{display:flex;justify-content:space-between;gap:16px;padding:19px 0 24px;border-top:1px solid var(--field-line);color:#858b80;font:400 .52rem 'DM Mono',monospace;letter-spacing:.02em;}\n.field-footer a{color:var(--field-brass);text-decoration:none;}\nbutton:focus-visible,a:focus-visible{outline:2px solid var(--field-brass);outline-offset:3px;}\n@media(max-width:1050px){.field-wrap{width:min(100% - 42px,1320px);}.header-nav{gap:2px}.header-nav a{padding:8px}.briefing-head{grid-template-columns:1fr 370px;gap:24px}.secondary-grid{grid-template-columns:1fr 1fr}.tool-row{grid-template-columns:1fr}.tool-panel{min-height:96px;}}\n@media(max-width:760px){.field-wrap{width:calc(100% - 32px)}.field-header{height:auto;min-height:70px;flex-wrap:wrap;padding:10px 0;gap:10px}.header-nav{order:3;width:100%;overflow:auto;border-top:1px solid var(--field-line);padding-top:8px}.header-nav a{flex:0 0 auto}.session-status{font-size:.49rem}.briefing-head{grid-template-columns:1fr;padding:34px 0 25px;gap:23px}.clock-panel{max-width:none}.scope-rail{overflow:auto}.scope-rail a{flex:0 0 auto;margin-right:16px;padding-right:4px}.scope-rail .scope-note{display:none}.work-panel{grid-template-columns:1fr}.work-context{grid-template-columns:repeat(3,1fr);border-top:1px solid var(--field-line);border-left:0;padding:15px 18px}.context-row{grid-template-columns:1fr;gap:4px}.secondary-grid{grid-template-columns:1fr}.tool-row{grid-template-columns:1fr}.map-head{grid-template-columns:46px minmax(0,1fr);padding:16px}.map-icon{width:40px;height:40px}.map-show{grid-column:2;justify-self:start}.map-foot{align-items:flex-start;flex-direction:column}.map-empty{align-items:flex-start;flex-direction:column}.map-state-actions{align-items:flex-start}.map-expand-note{text-align:left}.field-footer{flex-direction:column}.section-heading{align-items:flex-start;flex-direction:column}}\n@media(max-width:470px){.brand-title{font-size:1.27rem}.brand-mark{width:33px;height:33px}.session-tools{gap:7px}.session-status{padding:7px}.signout{font-size:.52rem}.briefing-head h1{font-size:3.3rem}.work-empty{align-items:flex-start;padding:22px 17px}.work-context{grid-template-columns:1fr}.schedule-panel,.connection-panel{padding:18px}.connection-action{align-items:flex-start;flex-direction:column}.connection-action p{max-width:none}.tool-panel{grid-template-columns:40px minmax(0,1fr) 28px;gap:11px;padding:15px}.tool-icon{width:38px;height:38px}.map-head{gap:11px;padding:14px}.map-description{font-size:.57rem}}\n</style>\n<main class=\"field-page\" data-kid=\"1\">\n    <header aria-label=\"ARRAI Detective Agency member navigation\" class=\"field-header field-wrap\" data-kid=\"1-1\">\n        <a aria-label=\"ARRAI Field Office member desk\" class=\"field-brand\" data-kid=\"1-1-1\" href=\"#briefing\">\n            <span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                <i class=\"ti ti-radar\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                <span class=\"brand-title\" data-kid=\"1-1-1-2-1\">\n                    ARRAI\n                </span>\n                <span class=\"brand-sub\" data-kid=\"1-1-1-2-2\">\n                    FIELD OFFICE · MEMBER DESK\n                </span>\n            </span>\n        </a>\n        <nav aria-label=\"Member workspace sections\" class=\"header-nav\" data-kid=\"1-1-2\">\n            <a class=\"active\" data-kid=\"1-1-2-1\" href=\"#briefing\">\n                Briefing\n            </a>\n            <a data-kid=\"1-1-2-2\" href=\"#private-work\">\n                Private work\n            </a>\n            <a data-kid=\"1-1-2-3\" href=\"#public-schedule\">\n                Public calendar\n            </a>\n            <a data-kid=\"1-1-2-4\" href=\"#map-shelf\">\n                Earth map\n            </a>\n        </nav>\n        <div class=\"session-tools\" data-kid=\"1-1-3\">\n            <span class=\"session-status\" data-kid=\"1-1-3-1\">\n                <i aria-hidden=\"true\" class=\"ti ti-shield-check\" data-kid=\"1-1-3-1-1\">\n                </i>\n                Verified member session\n            </span>\n            <button class=\"signout\" data-kid=\"1-1-3-2\" type=\"button\">\n                Sign out\n            </button>\n        </div>\n    </header>\n    <div class=\"field-wrap\" data-kid=\"1-2\">\n        <section aria-labelledby=\"briefing-title\" class=\"briefing-head\" data-kid=\"1-2-1\" id=\"briefing\">\n            <div data-kid=\"1-2-1-1\">\n                <p class=\"kicker\" data-kid=\"1-2-1-1-1\">\n                    ARRAI detective agency · member briefing\n                </p>\n                <h1 data-kid=\"1-2-1-1-2\" id=\"briefing-title\">\n                    Your daily\n                    <br data-kid=\"1-2-1-1-2-1\"/>\n                    <em data-kid=\"1-2-1-1-2-2\">\n                        field briefing.\n                    </em>\n                </h1>\n                <p class=\"briefing-intro\" data-kid=\"1-2-1-1-3\">\n                    A quick view of your assigned work and public resources. Private member information stays separate from public events and optional connection diagnostics.\n                </p>\n            </div>\n            <div aria-label=\"Local date and time on this device\" class=\"clock-panel\" data-kid=\"1-2-1-2\">\n                <span class=\"clock-label\" data-kid=\"1-2-1-2-1\">\n                    Today · browser-local time\n                </span>\n                <time class=\"clock-time\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2\" data-name=\"local time clock\" data-reason=\"text updated every 15 seconds by clock script\" id=\"local-time\">\n                    --:--\n                </time>\n                <span class=\"clock-zone\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3\" data-name=\"time zone display\" data-reason=\"text updated every 15 seconds by clock script\" id=\"local-zone\">\n                    Device\n                    <br data-kid=\"1-2-1-2-3-1\"/>\n                    time zone\n                </span>\n                <span class=\"clock-date\" data-dynamic=\"true\" data-kid=\"1-2-1-2-4\" data-name=\"local date display\" data-reason=\"text updated every 15 seconds by clock script\" id=\"local-date\">\n                    Date loads from this device\n                </span>\n                <span class=\"clock-note\" data-kid=\"1-2-1-2-5\">\n                    Local clock · not a case location or event time\n                </span>\n            </div>\n        </section>\n        <nav aria-label=\"Briefing data scopes\" class=\"scope-rail\" data-kid=\"1-2-2\">\n            <a data-kid=\"1-2-2-1\" href=\"#private-work\">\n                <span data-kid=\"1-2-2-1-1\">\n                    01\n                </span>\n                Private work\n            </a>\n            <a data-kid=\"1-2-2-2\" href=\"#public-schedule\">\n                <span data-kid=\"1-2-2-2-1\">\n                    02\n                </span>\n                Public schedule\n            </a>\n            <a data-kid=\"1-2-2-3\" href=\"#my-connection\">\n                <span data-kid=\"1-2-2-3-1\">\n                    03\n                </span>\n                My connection\n            </a>\n            <span class=\"scope-note\" data-kid=\"1-2-2-4\">\n                SEPARATE BY SOURCE · PRIVATE BY DEFAULT\n            </span>\n        </nav>\n        <section aria-labelledby=\"private-work-title\" class=\"section-block\" data-kid=\"1-2-3\" id=\"private-work\">\n            <div class=\"section-heading\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <p class=\"section-id\" data-kid=\"1-2-3-1-1-1\">\n                        <span data-kid=\"1-2-3-1-1-1-1\">\n                            01 /\n                        </span>\n                        Verified-member scope\n                    </p>\n                    <h2 data-kid=\"1-2-3-1-1-2\" id=\"private-work-title\">\n                        Private work\n                    </h2>\n                </div>\n                <span class=\"section-source\" data-kid=\"1-2-3-1-2\">\n                    <i aria-hidden=\"true\" class=\"ti ti-lock\" data-kid=\"1-2-3-1-2-1\">\n                    </i>\n                    Assigned cases only · private register\n                </span>\n            </div>\n            <div class=\"work-panel\" data-kid=\"1-2-3-2\">\n                <div class=\"work-empty\" data-kid=\"1-2-3-2-1\">\n                    <span aria-hidden=\"true\" class=\"empty-glyph\" data-kid=\"1-2-3-2-1-1\">\n                        <i class=\"ti ti-folder-search\" data-kid=\"1-2-3-2-1-1-1\">\n                        </i>\n                    </span>\n                    <div class=\"empty-copy\" data-kid=\"1-2-3-2-1-2\">\n                        <small data-kid=\"1-2-3-2-1-2-1\">\n                            Assigned-case register\n                        </small>\n                        <h3 data-kid=\"1-2-3-2-1-2-2\">\n                            No assigned case to preview\n                        </h3>\n                        <p data-kid=\"1-2-3-2-1-2-3\">\n                            When a case is assigned to this verified member account, its authorized summary will appear here. No private case details are shown in the public schedule or assistant.\n                        </p>\n                    </div>\n                </div>\n                <dl aria-label=\"Private work data boundary\" class=\"work-context\" data-kid=\"1-2-3-2-2\">\n                    <div class=\"context-row\" data-kid=\"1-2-3-2-2-1\">\n                        <dt data-kid=\"1-2-3-2-2-1-1\">\n                            Visible to\n                        </dt>\n                        <dd data-kid=\"1-2-3-2-2-1-2\">\n                            Verified member account\n                        </dd>\n                    </div>\n                    <div class=\"context-row\" data-kid=\"1-2-3-2-2-2\">\n                        <dt data-kid=\"1-2-3-2-2-2-1\">\n                            Source\n                        </dt>\n                        <dd data-kid=\"1-2-3-2-2-2-2\">\n                            Assigned-case register\n                        </dd>\n                    </div>\n                    <div class=\"context-row\" data-kid=\"1-2-3-2-2-3\">\n                        <dt data-kid=\"1-2-3-2-2-3-1\">\n                            Scope\n                        </dt>\n                        <dd data-kid=\"1-2-3-2-2-3-2\">\n                            Only work assigned to you\n                        </dd>\n                    </div>\n                </dl>\n            </div>\n        </section>\n        <div class=\"secondary-grid\" data-kid=\"1-2-4\">\n            <section aria-labelledby=\"public-schedule-title\" class=\"schedule-panel\" data-kid=\"1-2-4-1\" id=\"public-schedule\">\n                <div class=\"schedule-top\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <p class=\"section-id\" data-kid=\"1-2-4-1-1-1-1\">\n                            <span data-kid=\"1-2-4-1-1-1-1-1\">\n                                02 /\n                            </span>\n                            Public information\n                        </p>\n                        <h3 data-kid=\"1-2-4-1-1-1-2\" id=\"public-schedule-title\">\n                            Public schedule\n                        </h3>\n                    </div>\n                    <span class=\"public-chip\" data-kid=\"1-2-4-1-1-2\">\n                        Not a personal agenda\n                    </span>\n                </div>\n                <div class=\"schedule-rule\" data-kid=\"1-2-4-1-2\">\n                    <i aria-hidden=\"true\" class=\"ti ti-calendar-event\" data-kid=\"1-2-4-1-2-1\">\n                    </i>\n                    SOURCE · ARRAI PUBLIC CALENDAR · UPCOMING EVENTS\n                </div>\n                <div class=\"schedule-empty\" data-kid=\"1-2-4-1-3\">\n                    <i aria-hidden=\"true\" class=\"ti ti-calendar-off\" data-kid=\"1-2-4-1-3-1\">\n                    </i>\n                    <p data-kid=\"1-2-4-1-3-2\">\n                        No upcoming public events to preview.\n                        <br data-kid=\"1-2-4-1-3-2-1\"/>\n                        When available, event times and details will come from the public calendar.\n                    </p>\n                </div>\n                <a class=\"schedule-link\" data-kid=\"1-2-4-1-4\" href=\"calendar.html\">\n                    Open public calendar\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-2-4-1-4-1\">\n                    </i>\n                </a>\n            </section>\n            <section aria-labelledby=\"my-connection-title\" class=\"connection-panel\" data-kid=\"1-2-4-2\" id=\"my-connection\">\n                <div class=\"connection-top\" data-kid=\"1-2-4-2-1\">\n                    <div data-kid=\"1-2-4-2-1-1\">\n                        <p class=\"section-id\" data-kid=\"1-2-4-2-1-1-1\">\n                            <span data-kid=\"1-2-4-2-1-1-1-1\">\n                                03 /\n                            </span>\n                            Optional self-check\n                        </p>\n                        <h3 data-kid=\"1-2-4-2-1-1-2\" id=\"my-connection-title\">\n                            My connection\n                        </h3>\n                    </div>\n                    <span class=\"pending-mark\" data-dynamic=\"true\" data-kid=\"1-2-4-2-1-2\" data-name=\"connection status label\" data-reason=\"text updated on user interaction by connection script\" id=\"connection-status\">\n                        Not checked\n                    </span>\n                </div>\n                <p class=\"connection-copy\" data-kid=\"1-2-4-2-2\">\n                    Check only the public connection used by this browser. IP and network details stay hidden until you request a lookup.\n                </p>\n                <div class=\"connection-action\" data-kid=\"1-2-4-2-3\">\n                    <p data-kid=\"1-2-4-2-3-1\">\n                        VPN / proxy result is an estimate—not a security verdict.\n                    </p>\n                    <button class=\"action-button\" data-dynamic=\"true\" data-kid=\"1-2-4-2-3-2\" data-name=\"check my connection button\" data-reason=\"text and attributes updated on click by script\" id=\"connection-check\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-world-search\" data-kid=\"1-2-4-2-3-2-1\">\n                        </i>\n                        Check my connection\n                    </button>\n                </div>\n                <p class=\"connection-disclaimer\" data-kid=\"1-2-4-2-4\">\n                    Any IP-based region is approximate. It describes a network connection, not the identity or precise location of a person.\n                </p>\n            </section>\n        </div>\n        <section aria-label=\"Optional member tools\" class=\"tool-row\" data-kid=\"1-2-5\">\n            <article class=\"tool-panel\" data-kid=\"1-2-5-1\" id=\"site-help\">\n                <span aria-hidden=\"true\" class=\"tool-icon\" data-kid=\"1-2-5-1-1\">\n                    <i class=\"ti ti-message-chatbot\" data-kid=\"1-2-5-1-1-1\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-5-1-2\">\n                    <p class=\"tool-kicker\" data-kid=\"1-2-5-1-2-1\">\n                        ARRAI site guide\n                    </p>\n                    <h3 data-kid=\"1-2-5-1-2-2\">\n                        Ask AR for help\n                    </h3>\n                    <p data-kid=\"1-2-5-1-2-3\">\n                        Public site guidance only · the assistant cannot view assigned cases or private member records.\n                    </p>\n                </div>\n                <span aria-hidden=\"true\" class=\"tool-go\" data-kid=\"1-2-5-1-3\">\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-5-1-3-1\">\n                    </i>\n                </span>\n            </article>\n            <article class=\"tool-panel science\" data-kid=\"1-2-5-2\" id=\"space-science\">\n                <span aria-hidden=\"true\" class=\"tool-icon\" data-kid=\"1-2-5-2-1\">\n                    <i class=\"ti ti-planet\" data-kid=\"1-2-5-2-1-1\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-5-2-2\">\n                    <p class=\"tool-kicker\" data-kid=\"1-2-5-2-2-1\">\n                        Optional science view\n                    </p>\n                    <h3 data-kid=\"1-2-5-2-2-2\">\n                        Solar system & space\n                    </h3>\n                    <p data-kid=\"1-2-5-2-2-3\">\n                        Educational view · no live science feed is claimed in this dashboard.\n                    </p>\n                </div>\n                <span aria-hidden=\"true\" class=\"tool-go\" data-kid=\"1-2-5-2-3\">\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-5-2-3-1\">\n                    </i>\n                </span>\n            </article>\n        </section>\n        <section aria-labelledby=\"map-title\" class=\"map-shelf\" data-dynamic=\"true\" data-kid=\"1-2-6\" data-name=\"expandable map shelf section\" data-reason=\"class is-map-expanded toggled by script\" id=\"map-shelf\">\n            <div class=\"map-head\" data-kid=\"1-2-6-1\">\n                <span aria-hidden=\"true\" class=\"map-icon\" data-kid=\"1-2-6-1-1\">\n                    <i class=\"ti ti-world\" data-kid=\"1-2-6-1-1-1\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-6-1-2\">\n                    <p class=\"map-label\" data-kid=\"1-2-6-1-2-1\">\n                        Earth · global view\n                    </p>\n                    <h2 class=\"map-title\" data-kid=\"1-2-6-1-2-2\" id=\"map-title\">\n                        Explore the world map\n                    </h2>\n                    <p class=\"map-description\" data-kid=\"1-2-6-1-2-3\">\n                        A separate geography view. No member pins or connection location are shown by default.\n                    </p>\n                </div>\n                <button aria-controls=\"map-panel\" aria-expanded=\"false\" class=\"map-show\" data-dynamic=\"true\" data-kid=\"1-2-6-1-3\" data-name=\"toggle map visibility button\" data-reason=\"text and attributes updated on click by script\" id=\"map-toggle\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-map-2\" data-kid=\"1-2-6-1-3-1\">\n                    </i>\n                    <span data-kid=\"1-2-6-1-3-2\">\n                        Show map\n                    </span>\n                </button>\n            </div>\n            <div class=\"map-panel\" data-dynamic=\"true\" data-kid=\"1-2-6-2\" data-name=\"collapsible map panel\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"map-panel\">\n                <div class=\"map-empty\" data-kid=\"1-2-6-2-1\">\n                    <div data-kid=\"1-2-6-2-1-1\">\n                        <h3 data-kid=\"1-2-6-2-1-1-1\">\n                            Map layer not loaded in this preview\n                        </h3>\n                        <p data-kid=\"1-2-6-2-1-1-2\">\n                            No map tiles, member locations, or connection markers are included here. A provider and attribution should be shown when a real map source is connected.\n                        </p>\n                    </div>\n                    <div class=\"map-state-actions\" data-kid=\"1-2-6-2-1-2\">\n                        <button class=\"map-expand\" data-dynamic=\"true\" data-kid=\"1-2-6-2-1-2-1\" data-name=\"expand map area button\" data-reason=\"text and icon updated on click by script\" id=\"map-expand\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-arrows-maximize\" data-kid=\"1-2-6-2-1-2-1-1\">\n                            </i>\n                            Expand map area\n                        </button>\n                        <span class=\"map-expand-note\" data-kid=\"1-2-6-2-1-2-2\">\n                            Map-area expand is separate from F11 browser full-screen.\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"map-foot\" data-kid=\"1-2-6-3\">\n                <span data-kid=\"1-2-6-3-1\">\n                    OPTIONAL · LOADS WHEN SHOWN\n                </span>\n                <span data-kid=\"1-2-6-3-2\">\n                    F11 toggles browser full-screen · press F11 again to exit\n                </span>\n            </div>\n        </section>\n        <footer class=\"field-footer\" data-kid=\"1-2-7\">\n            <span data-kid=\"1-2-7-1\">\n                ARRAI DETECTIVE AGENCY · VERIFIED MEMBER WORKSPACE\n            </span>\n            <span data-kid=\"1-2-7-2\">\n                Private work · public schedule · self-connection diagnostics\n            </span>\n            <a data-kid=\"1-2-7-3\" href=\"calendar.html\">\n                Public calendar ↗\n            </a>\n        </footer>\n    </div>\n</main>\n<script>\n    (() => {\n  const timeNode = document.getElementById('local-time');\n  const dateNode = document.getElementById('local-date');\n  const zoneNode = document.getElementById('local-zone');\n  const refreshClock = () => {\n    const now = new Date();\n    const locale = navigator.language || undefined;\n    const time = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit' });\n    const date = new Intl.DateTimeFormat(locale, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });\n    const zoneName = new Intl.DateTimeFormat(locale, { timeZoneName: 'short' }).formatToParts(now).find((part) => part.type === 'timeZoneName')?.value || 'Local';\n    timeNode.textContent = time.format(now);\n    dateNode.textContent = date.format(now);\n    zoneNode.innerHTML = `${Intl.DateTimeFormat().resolvedOptions().timeZone || 'Local time'}<br>${zoneName} · local`;\n  };\n  refreshClock();\n  window.setInterval(refreshClock, 15000);\n\n  const connectionButton = document.getElementById('connection-check');\n  const connectionStatus = document.getElementById('connection-status');\n  connectionButton.addEventListener('click', () => {\n    connectionStatus.textContent = 'Source needed';\n    connectionButton.disabled = true;\n    connectionButton.innerHTML = '<i class=\"ti ti-info-circle\" aria-hidden=\"true\"></i> Lookup source not connected';\n    connectionButton.setAttribute('aria-label', 'Connection lookup is not connected in this preview');\n  });\n\n  const mapSection = document.getElementById('map-shelf');\n  const mapButton = document.getElementById('map-toggle');\n  const mapPanel = document.getElementById('map-panel');\n  const mapExpand = document.getElementById('map-expand');\n  mapButton.addEventListener('click', () => {\n    const show = mapPanel.hidden;\n    mapPanel.hidden = !show;\n    mapButton.setAttribute('aria-expanded', String(show));\n    mapButton.innerHTML = show ? '<i class=\"ti ti-eye-off\" aria-hidden=\"true\"></i><span>Hide map</span>' : '<i class=\"ti ti-map-2\" aria-hidden=\"true\"></i><span>Show map</span>';\n  });\n  mapExpand.addEventListener('click', () => {\n    const expanded = mapSection.classList.toggle('is-map-expanded');\n    mapExpand.innerHTML = expanded ? '<i class=\"ti ti-arrows-minimize\" aria-hidden=\"true\"></i> Exit map-area expand' : '<i class=\"ti ti-arrows-maximize\" aria-hidden=\"true\"></i> Expand map area';\n  });\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape') {\n      mapSection.classList.remove('is-map-expanded');\n      mapExpand.innerHTML = '<i class=\"ti ti-arrows-maximize\" aria-hidden=\"true\"></i> Expand map area';\n    }\n  });\n})();\n</script>\n",
