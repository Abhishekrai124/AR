{
  "cleanUrls": true,
  "crons": [
    { "path": "/api/detective-retention", "schedule": "0 3 * * *" },
    { "path": "/api/vip-expiry", "schedule": "15 3 * * *" }
  ],
  "rewrites": [
    { "source": "/api/staff", "destination": "/api/owner?action=staff" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/detective", "destination": "/detective.html" },
    { "source": "/detective-members", "destination": "/detective-members.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/case-file", "destination": "/case-file.html" },
    { "source": "/music", "destination": "/music.html" },
    { "source": "/chess", "destination": "/chess.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/owner", "destination": "/owner.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/community", "destination": "/community.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/family", "destination": "/family.html" },
    { "source": "/dm", "destination": "/dm.html" },
    { "source": "/calendar", "destination": "/calendar.html" },
    { "source": "/abhishek-rai", "destination": "/founder.html" },
    { "source": "/:username", "destination": "/profile.html" }
  ]
}
